+export function microscopePanelId(): string { return 'microscope-panel'; }
+
+/** Abre o painel do Microscópio dividindo a tela: metade placa, metade câmera. */
+export function ensureMicroscopePanel(): void {
+  try {
+    const api = getDockviewApi();
+    if (!api) return;
+    const id = microscopePanelId();
+    const existing = api.getPanel(id);
+    if (existing) { existing.api.setActive(); return; }
+    const anyBoard = api.panels.find(p => p.id.startsWith('board-'));
+    api.addPanel({
+      id,
+      component: 'microscope',
+      title: 'Microscópio',
+      ...(anyBoard
+        ? { position: { referencePanel: anyBoard.id, direction: 'right' as const } }
+        : {}),
+    });
+  } catch (err) {
+    log.ui.error('Failed to open Microscope panel:', err);
+  }
+}
