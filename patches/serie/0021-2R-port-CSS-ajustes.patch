From 86a4d4b2673d7fb591f71ae6015be93fd990611c Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 28 Oct 2026 20:47:53 -0300
Subject: [PATCH 21/31] 2R port CSS + ajustes

---
 src/frontend/src/index.css | 504 ++++++++++++++++++++++++++++++++++++-
 1 file changed, 501 insertions(+), 3 deletions(-)

diff --git a/src/frontend/src/index.css b/src/frontend/src/index.css
index 0c69c9d7..c3c3a95a 100644
--- a/src/frontend/src/index.css
+++ b/src/frontend/src/index.css
@@ -1142,7 +1142,7 @@ body {
  * A second view over Sidebar.utils.ts state. Always visible; the sidebar
  * beside it opens/hides. Spec: docs/specs/2026-09-02-activity-rail-design.md */
 .activity-rail {
-  width: 46px;
+  width: 56px; /* 2R 21/10/2026: legendas embaixo dos ícones */
   flex-shrink: 0;
   height: 100%;
   background: var(--bg-tertiary);
@@ -1241,7 +1241,7 @@ body {
 .activity-rail-ico svg { display: block; }
 .activity-rail-cap {
   font-size: 8px;
-  letter-spacing: 0.02em;
+  letter-spacing: 0;
   line-height: 1;
   white-space: nowrap;
 }
@@ -4853,7 +4853,7 @@ body {
 
 .pdf-click-highlight {
   position: absolute;
-  border: 1px solid #ffaa00;
+  border: 2px solid #d6ff00; /* 2R 25/10/2026: marca-texto */
   pointer-events: none;
   z-index: 5;
   box-sizing: border-box;
@@ -10496,3 +10496,501 @@ html.r2-light .r2-menubar-logo, html.r2-light .r2-toolbar-logo, html.r2-light .r
 .r2gd-tstar { background:transparent; border:0; color:var(--r2-line,#3A3E45); font-size:16px; cursor:pointer; padding:0; }
 .r2gd-tstar.on { color:#2E9E5B; }
 .r2gd-tfoot { padding:9px; border-top:1px solid var(--r2-line,#1E2125); background:var(--r2-bg2,#121418); }
+
+/* ===== 2R Tools — CSS que estava editado à mão no bundle 0.48.0 (portado para o fonte em 28/10/2026) ===== */
+/* Relatório do ponto a ponto (r2rep, 12/10/2026) */
+.r2rep {
+  margin-top: 6px;
+}
+.r2rep-head {
+  display: flex;
+  align-items: flex-start;
+  gap: 10px;
+  padding: 4px 2px 12px;
+}
+.r2rep-ti {
+  font-size: 15px;
+  font-weight: 800;
+  color: var(--r2-text, #eceae4);
+}
+.r2rep-sub {
+  font-size: 12px;
+  color: var(--r2-dim, #9aa0a6);
+  margin-top: 2px;
+}
+.r2rep-sum {
+  margin-left: auto;
+  display: flex;
+  gap: 6px;
+  flex-wrap: wrap;
+}
+.r2rep-chip {
+  font-size: 11.5px;
+  font-weight: 700;
+  border: 1px solid var(--r2-line, #33373e);
+  color: var(--r2-dim, #9aa0a6);
+  border-radius: 12px;
+  padding: 3px 9px;
+  white-space: nowrap;
+}
+.r2rep-chip.bad {
+  border-color: #e0864a;
+  color: #e0864a;
+}
+.r2rep-tbl {
+  border: 1px solid var(--r2-line, #2a2d33);
+  border-radius: 10px;
+  overflow: hidden;
+}
+.r2rep-thd,
+.r2rep-row {
+  display: grid;
+  grid-template-columns: 26px 1.3fr 0.9fr 0.8fr 0.8fr 0.7fr 0.8fr;
+  align-items: center;
+  gap: 6px;
+  padding: 8px 10px;
+}
+.r2rep-thd {
+  background: var(--r2-bg2, #16181b);
+  font-size: 10px;
+  font-weight: 800;
+  color: var(--r2-dim, #9aa0a6);
+  letter-spacing: 0.3px;
+  text-transform: uppercase;
+}
+.r2rep-row {
+  border-top: 1px solid var(--r2-line, #1e2125);
+  font-size: 12.5px;
+}
+.r2rep-row.fora {
+  background: #e0864a12;
+}
+.r2rep-n,
+.r2rep-pt {
+  color: var(--r2-mute, #6e6e6a);
+  font-variant-numeric: tabular-nums;
+}
+.r2rep-nm {
+  font-weight: 600;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.r2rep-v {
+  font-variant-numeric: tabular-nums;
+  font-weight: 700;
+}
+.r2rep-v.bad {
+  color: #e0864a;
+}
+.r2rep-tp {
+  color: var(--r2-dim, #9aa0a6);
+  font-size: 11.5px;
+}
+.r2rep-res {
+  font-size: 11px;
+  font-weight: 800;
+  text-align: center;
+}
+.r2rep-res.ok {
+  color: var(--r2-dim, #9aa0a6);
+}
+.r2rep-res.fora {
+  color: #e0864a;
+}
+.r2rep-foot {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  padding: 11px 2px 4px;
+}
+.r2rep-saved {
+  font-size: 11.5px;
+  color: var(--r2-dim, #9aa0a6);
+}
+.r2rep-print-head {
+  display: none;
+}
+@media print {
+  body * {
+    visibility: hidden !important;
+  }
+  .r2rep,
+  .r2rep * {
+    visibility: visible !important;
+  }
+  .r2rep {
+    position: absolute;
+    left: 0;
+    top: 0;
+    width: 100%;
+    margin: 0;
+    padding: 24px 28px;
+    background: #fff !important;
+    color: #1a1a1a !important;
+  }
+  .r2rep-print-head {
+    display: block;
+    border-bottom: 2px solid #1f2933;
+    padding-bottom: 8px;
+    margin-bottom: 14px;
+  }
+  .r2rep-print-head .b {
+    font-size: 20px;
+    font-weight: 900;
+    letter-spacing: 1px;
+    color: #1f2933;
+  }
+  .r2rep-print-head .b small {
+    font-size: 10px;
+    letter-spacing: 3px;
+    color: #52606d;
+    font-weight: 700;
+  }
+  .r2rep-ti,
+  .r2rep-nm,
+  .r2rep-v {
+    color: #1a1a1a !important;
+  }
+  .r2rep-sub,
+  .r2rep-pt,
+  .r2rep-tp,
+  .r2rep-n {
+    color: #52606d !important;
+  }
+  .r2rep-chip {
+    border-color: #b5b5b5 !important;
+    color: #1f2933 !important;
+  }
+  .r2rep-chip.bad {
+    border-color: #c0392b !important;
+    color: #c0392b !important;
+  }
+  .r2rep-tbl {
+    border-color: #b5b5b5 !important;
+  }
+  .r2rep-thd {
+    background: #e4e4e4 !important;
+    color: #1f2933 !important;
+  }
+  .r2rep-row {
+    border-top-color: #dadfe6 !important;
+  }
+  .r2rep-row.fora {
+    background: #fbeae6 !important;
+  }
+  .r2rep-v.bad,
+  .r2rep-res.fora {
+    color: #c0392b !important;
+  }
+  .r2rep-res.ok {
+    color: #52606d !important;
+  }
+  .r2rep-foot,
+  .r2rep-saved,
+  .r2acv-note {
+    display: none !important;
+  }
+}
+
+
+/* Post-its do Ponto a ponto (Roger, 16/10/2026): amarelo = explicação, vermelho = atenção, verde = valor esperado */
+.r2pi-wrap {
+  display: block;
+}
+.r2pi-plain {
+  display: block;
+  margin: 2px 0;
+}
+.r2pi {
+  display: block;
+  margin: 3px 0;
+  padding: 4px 7px;
+  border-radius: 3px;
+  font-size: 10.5px;
+  font-weight: 400;
+  line-height: 1.3;
+  color: #2b2b2b;
+  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
+  border-left: 3px solid transparent;
+  word-break: break-word;
+}
+.r2pi-explica {
+  background: #fff0a0;
+  border-left-color: #e0c020;
+}
+.r2pi-atencao {
+  background: #ffb8b0;
+  border-left-color: #d03020;
+}
+.r2pi-esperado {
+  background: #bfe8b4;
+  border-left-color: #3a9a2a;
+}
+.r2pi-resolvido {
+  background: #bcdcff;
+  border-left-color: #2a6fc0;
+}
+.r2pi-resolvido:before {
+  content: "✔ RESOLVIDO  ";
+  font-weight: 800;
+  font-size: 9.5px;
+  letter-spacing: 0.3px;
+  color: #1d4f8f;
+}
+.r2gd-hud-sub .r2pi {
+  display: inline-block;
+  margin: 2px 4px 0 0;
+}
+
+/*2R-legenda-compacta 16/10/2026 (Roger: «painel de cores da net bem localizado, menor espaço possível… está truncado»)
+  texto NUNCA cortado (quebra de linha), itens lado a lado, letra e margens menores, largura = conteúdo,
+  canto inferior esquerdo bem rente à borda; fica mais clara quando o mouse não está sobre ela. */
+.r2-legend {
+  left: 6px;
+  bottom: 6px;
+  width: max-content;
+  max-width: min(320px, 42%);
+  padding: 3px 6px;
+  font-size: 0.72em;
+  line-height: 1.25;
+  border-radius: 5px;
+  box-shadow: 0 2px 8px #0006;
+  opacity: 0.92;
+}
+.r2-legend:hover {
+  opacity: 1;
+}
+.r2-legend.closed {
+  padding: 2px 6px;
+}
+.r2-legend-head {
+  gap: 6px;
+}
+.r2-legend-group {
+  margin-top: 3px;
+  display: flex;
+  flex-wrap: wrap;
+  gap: 1px 8px;
+  align-items: flex-start;
+}
+.r2-legend-label {
+  flex: 0 0 100%;
+  margin-bottom: 0;
+  font-size: 0.82em;
+  letter-spacing: 0.3px;
+}
+.r2-legend-row {
+  flex: 0 1 auto;
+  max-width: 100%;
+  align-items: flex-start;
+  gap: 4px;
+  padding: 0;
+}
+.r2-legend-dot {
+  width: 8px;
+  height: 8px;
+  flex: 0 0 8px;
+  margin-top: 0.28em;
+}
+.r2-legend-kw {
+  white-space: normal;
+  overflow: visible;
+  text-overflow: clip;
+  overflow-wrap: anywhere;
+  min-width: 0;
+}
+.r2-legend.embedded {
+  max-width: none;
+  width: auto;
+  padding: 3px 8px;
+  opacity: 1;
+}
+.r2-legend-sidebar {
+  max-height: none;
+  overflow: auto;
+  position: relative;
+  border-top: 3px double var(--r2-line-soft);
+}
+.r2-legend-sidebar::before {
+  content: "";
+  position: absolute;
+  left: 0;
+  right: 0;
+  top: -3px;
+  height: 9px;
+  cursor: ns-resize;
+}
+
+/*2R-grupo 16/10/2026: pontos do mesmo passo ficam numa linha só na lista (o nome da net muda ao avançar)*/
+.r2gd-step.r2gd-hide {
+  display: none;
+}
+
+/* 17/10/2026 (Roger): nuvem do Acervo 2R só na lateral; dourada quando o painel está aberto */
+.activity-rail-item[data-sidebar-tab="acervo"].active,
+.activity-rail[data-collapsed="true"]
+  .activity-rail-item[data-sidebar-tab="acervo"].active {
+  color: #d9a441;
+}
+.activity-rail-item[data-sidebar-tab="acervo"].active:before,
+.activity-rail[data-collapsed="true"]
+  .activity-rail-item[data-sidebar-tab="acervo"].active:before {
+  background: #d9a441;
+  opacity: 1;
+}
+
+/* 17/10/2026 (Roger): botão «Sidebar → icons only» no canto DIREITO da barra do topo; os menus avançam até a borda esquerda */
+.toolbar {
+  padding-left: 8px;
+}
+.toolbar .toolbar-btn.toolbar-railcell {
+  border-right: 0;
+  border-left: 1px solid var(--border);
+  margin-left: 2px;
+  margin-right: -8px;
+}
+
+/* 17/10/2026 (Roger): nome da função embaixo de cada ícone da barra sobre a placa */
+.r2-capw {
+  display: inline-flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 1px;
+  flex: none;
+}
+.r2-cap {
+  font-size: 9px;
+  line-height: 10px;
+  color: var(--text-secondary);
+  white-space: nowrap;
+  pointer-events: none;
+  letter-spacing: 0.2px;
+}
+.r2-capw:hover .r2-cap {
+  color: var(--text-primary);
+}
+
+.board-perf-overlay,
+.board-perf-toggle {
+  display: none !important;
+}
+
+[aria-labelledby="load-progress-title"] {
+  display: none !important;
+}
+
+/* 2R 23/10/2026 (Roger: «pode aplicar esse contorno branco em tudo que estiver ativado»): TUDO que está ligado —
+   ícones, barra lateral, botões de texto e abas — ganha o mesmo contorno branco fino, sem brilho, fundo preto.
+   Ícones e barra lateral mantêm a cor por dentro (amarelo; gravação/microfone em vermelho); texto fica branco em negrito */
+.nav2r-btn.active,
+.pdf-toolbar-btn.active,
+.toolbar-btn.active,
+.activity-rail-item.active,
+.activity-rail-item[aria-pressed="true"] {
+  box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.85) !important;
+  background-color: #000 !important;
+  color: #ffd60a !important;
+  transition: box-shadow 0.15s;
+}
+button[aria-pressed="true"]:not(.nav2r-btn):not(.pdf-toolbar-btn):not(
+    .toolbar-btn
+  ):not(.activity-rail-item) {
+  box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.85) !important;
+  border-color: transparent !important;
+  color: #ffffff !important;
+  font-weight: 700 !important;
+  background-color: #000 !important;
+  transition: box-shadow 0.15s;
+}
+.nav2r-btn.active[title*="Grava" i],
+.nav2r-btn.active[title*="Microf" i],
+button[aria-pressed="true"][title*="Grava" i] {
+  box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.85) !important;
+  color: #ff4d4d !important;
+}
+.activity-rail-item.active:before {
+  display: none !important;
+}
+.activity-rail-item.active,
+.activity-rail-item[aria-pressed="true"] {
+  border-radius: 6px;
+  width: calc(100% - 8px) !important;
+  margin-left: 4px;
+  margin-right: 4px;
+}
+
+/* 2R padrão (24/10/2026, Roger: «quando clica aparece o preenchimento azul, não quero»): ativo = preto + contorno branco fino; destaque (accent) branco no lugar do azul */
+:root {
+  --accent: #ffffff !important;
+  --accent-hover: #dadada !important;
+  --accent-fg: #000000 !important;
+  --accent-color: #ffffff !important;
+  --accent-text: #ffffff !important;
+  --surface-active: rgba(255, 255, 255, 0.08) !important;
+  --surface-hover: rgba(255, 255, 255, 0.06) !important;
+}
+.board-netlines-toggle.active,
+.fold-swap-btn.active {
+  background: #000 !important;
+  color: #fff !important;
+  border-color: rgba(255, 255, 255, 0.85) !important;
+}
+.ctxmenu-chip-action.is-lit,
+.gesture-rec-apply,
+.gesture-rec-segbtn.is-active,
+.home-open-btn-primary,
+.interactive-mode-toggle.active,
+.library-detail-icon.primary,
+.library-folder-btn,
+.library-modal-save,
+.overlay-seg-btn.active,
+.pdf-toolbar-btn.active,
+.pdf-toolbar-group .pdf-toolbar-btn.active,
+.rc-count-btn.active,
+.session-restore-btn.primary,
+.settings-action-btn.active,
+.settings-btn-option.active,
+.settings-mode-btn.active,
+.toolbar-btn.active,
+.toolbar-btn.toolbar-quiet.active,
+.toolbar-group .toolbar-btn.active,
+.toolbar-pdf-option.active,
+.wl-pill {
+  background: #000 !important;
+  color: #fff !important;
+  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.85) !important;
+}
+.bind-link-option:hover,
+.color-rule-add-btn:hover,
+.context-menu-item:hover,
+.ctxmenu-chip-action:hover,
+.ctxmenu-chip-value:hover,
+.library-bind-candidate:hover,
+.library-detail-bind-btn:hover,
+.library-detail-icon.primary:hover,
+.library-modal-save:hover,
+.library-scan-btn:hover:not(:disabled),
+.library-search-btn:hover,
+.panel-adder-item:hover,
+.pdf-toolbar-btn:hover:not(:disabled),
+.pdf-toolbar-group .pdf-toolbar-btn:hover:not(:disabled),
+.quick-menu button:focus-visible,
+.quick-menu button:hover:not(:disabled),
+.settings-action-btn:hover:not(:disabled),
+.settings-reset-btn:hover,
+.toolbar-btn:hover:not(:disabled),
+.toolbar-group .toolbar-btn-icon:hover,
+.toolbar-group .toolbar-btn:hover,
+.toolbar-pdf-option:hover,
+.toolbar-search-option:hover,
+.ui-scale-full-reset:hover {
+  background: #23262b !important;
+  color: #fff !important;
+}
+.library-tab.active,
+.icon-tab.active {
+  background: #000 !important;
+  color: #fff !important;
+  border-color: rgba(255, 255, 255, 0.85) !important;
+}
-- 
