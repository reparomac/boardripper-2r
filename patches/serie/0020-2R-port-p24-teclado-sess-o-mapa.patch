+      // 2R 18/10/2026: Ctrl+←/→ gira a placa (no PDF também gira a placa — o PDF não gira)
+      if (e.ctrlKey && !e.metaKey && !e.altKey && !e.shiftKey && (e.key === 'ArrowLeft' || e.key === 'ArrowRight')) {
+        const x = activePanelKind();
+        if (x === 'board' || x === 'pdf') {
+          e.preventDefault();
+          const w = e.key === 'ArrowLeft' ? 'cw' : 'ccw';
+          if (x === 'pdf') pdfStore.rotateActive(w); else if (w === 'ccw') boardStore.rotateCCW(); else boardStore.rotateCW();
+          return;
+        }
+      }
+      // 2R 24/10/2026 (Roger: «a tecla N (next) serve para saltar para o próximo resultado localizado no PDF e no BDV;
+      // em ponto a ponto salta para a próxima leitura»): N = próximo, Shift+N = anterior
+      const r2k = window as unknown as { __r2TeclaN?: boolean; __r2NBusca?: string; __r2seq?: { on: boolean; next(): void; prev(): void } };
+      if (!e.ctrlKey && !e.metaKey && !e.altKey && (e.key === 'n' || e.key === 'N') && r2k.__r2TeclaN !== false) {
+        const vo = e.shiftKey;
+        try {
+          const sq = r2k.__r2seq;
+          if (sq && sq.on && r2k.__r2NBusca !== 'pdf') { e.preventDefault(); if (vo) sq.prev(); else sq.next(); return; }
+        } catch { /* */ }
+        if (pdfStore.matches.length > 0) { e.preventDefault(); if (vo) pdfStore.prevMatch(); else pdfStore.nextMatch(); return; }
+        try { if (stepPin(vo ? -1 : 1)) { e.preventDefault(); return; } } catch { /* */ }
+      }
+
