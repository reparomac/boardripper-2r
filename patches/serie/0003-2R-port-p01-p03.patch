+// 2R Tools — chaves e utilidades pequenas das edições à mão do bundle 0.48.0 (portadas para o fonte).
+/* 2R 20/10/2026: pads em cinza discreto (só a net escolhida acende). localStorage «2r-pads-coloridos»="1" volta às cores */
+let R2PC: boolean | null = null;
+export function r2PadsColoridos(): boolean {
+  if (R2PC === null) {
+    try { R2PC = localStorage.getItem('2r-pads-coloridos') === '1'; } catch { R2PC = false; }
+  }
+  return R2PC;
+}
+export const R2_PAD_CINZA_BOTTOM = 6974058; // 0x6a6a6a
+export const R2_PAD_CINZA_TOP = 7960953; // 0x797979
