+let gTab: number | null = null;
+function guideTab() {
+  const t = gTab != null ? boardStore.tabs.find(x => x.id === gTab && x.board) : undefined;
+  if (t) return t;
+  gTab = null;
+  const at = boardStore.activeTab;
+  if (on && active && at?.board && matchesBoard(active, at.fileName || '')) { gTab = boardStore.activeTabId; return at; }
+  return boardStore.activeTab?.board ? boardStore.activeTab : (active && on ? boardStore.tabs.find(x => x.board) ?? null : null);
+}
+function naAbaDoEstudo(): boolean { return gTab == null || boardStore.activeTabId === gTab; }
+
 function current(): Resolved | null {
