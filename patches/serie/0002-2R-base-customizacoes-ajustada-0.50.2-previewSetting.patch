---
 src/frontend/src/panels/SettingsPanel.tsx | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/src/frontend/src/panels/SettingsPanel.tsx b/src/frontend/src/panels/SettingsPanel.tsx
index 3c2ae51b..16049b1d 100644
--- a/src/frontend/src/panels/SettingsPanel.tsx
+++ b/src/frontend/src/panels/SettingsPanel.tsx
@@ -1843,9 +1843,10 @@ export function SettingsPanel() {
   // onde é» — no 2R cada mudança aparece na placa na hora (Apply grava, Cancelar volta).
   useEffect(() => {
     if (!IS_2R || !dirty) return;
-    renderSettingsStore.applySettings(draft);
+    // 0.50.2: applySettings virou previewSettings(settings, camada) — o tema fica por cima, sem gravar a paleta
+    renderSettingsStore.previewSettings(draft, isBoardMode ? 'board' : 'global');
     setPreviewing(true);
-  }, [draft, dirty]);
+  }, [draft, dirty]); // eslint-disable-line react-hooks/exhaustive-deps
   const previewingRef = useRef(previewing);
   previewingRef.current = previewing;
   // What the draft stands for: global⊕board in board mode, global otherwise.
