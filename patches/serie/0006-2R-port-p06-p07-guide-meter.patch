+const r2w = window as R2W;
+
+/* 2R 21/10/2026 (Roger): a cada passo, mesmo zoom do usuário e o pad no centro — se a área da placa mudar de
+   tamanho logo depois (coluna/esquemático abrindo), centraliza de novo */
+function r2Recentra(t: Point) {
+  const R = r2w.__2rRend;
+  if (!R || !R.containerEl) return;
+  const w0 = R.containerEl.clientWidth, h0 = R.containerEl.clientHeight;
+  clearTimeout(r2w.__r2rc);
+  r2w.__r2rc = setTimeout(() => {
+    const R2 = r2w.__2rRend;
+    if (!R2 || !R2.containerEl || !on) return;
+    if (R2.containerEl.clientWidth !== w0 || R2.containerEl.clientHeight !== h0) {
+      const s = boardStore.activeTab?.selection;
+      if (s && s.partIndex === t.partIndex && s.pinIndex === t.pinIndex) boardStore.focusPinKeepZoom(t.partIndex, t.pinIndex);
+    }
+  }, 650);
+}
+/* 2R 26/10/2026 (Roger): «durante os estudos, quando mudar de ponto, ir para o ponto mais próximo em relação ao ponto
+   anterior» — entre os pontos medíveis da net, vai para o mais perto do ponto do passo anterior; ponto fixado à mão vale */
+function r2PtAtual(): { x: number; y: number; side?: string } | null {
+  try {
+    const c = current(), b = boardStore.activeTab?.board;
+    const t = c && c.points[pointIdx % Math.max(1, c.points.length)];
+    const p = t && b && b.parts[t.partIndex]?.pins[t.pinIndex];
+    return p && b ? { x: p.position.x, y: p.position.y, side: b.parts[t!.partIndex].side } : null;
+  } catch { return null; }
+}
+function r2Perto(p: { x: number; y: number; side?: string } | null | undefined): number {
+  try {
+    if (!p || r2w.__r2PertoOff) return 0;
+    const c = current(), b = boardStore.activeTab?.board;
+    if (!c || !b || !c.points.length || c.points[0].fixed) return 0;
+    let a = c.points.map((t, k) => ({ t, k })).filter(o => o.t.kind !== 'outro');
+    if (!a.length) a = c.points.map((t, k) => ({ t, k }));
+    let m = 0, d = Infinity;
+    for (const o of a) {
+      const pt = b.parts[o.t.partIndex], q = pt?.pins[o.t.pinIndex];
+      if (!q) continue;
+      const e = (q.position.x - p.x) ** 2 + (q.position.y - p.y) ** 2 + (p.side != null && pt.side != null && pt.side !== p.side ? 1e-9 : 0);
+      if (e < d) { d = e; m = o.k; }
+    }
+    return m;
+  } catch { return 0; }
+}
+/* 2R 26/10/2026 (Roger: «quando fizer uma busca no PDF, clicar duas vezes, mostrar já o componente exato no BDV, se
+   possível inverter o lado bottom e top»): peça no lado escondido → vira a placa para o lado dela; com os dois lados ou
+   borboleta, não mexe */
+export function r2LadoPeca(w: string): void {
+  try {
+    const t = boardStore.activeTab, b = t?.board;
+    if (!t || !b || t.butterfly) return;
+    const W = String(w).toUpperCase(), P = b.parts.find(p => p.name.toUpperCase() === W);
+    if (!P || (P.side !== 'top' && P.side !== 'bottom')) return;
+    const vis = P.side === 'top' ? t.showTop : t.showBottom;
+    if (!vis) boardStore.r2Patch({ showTop: P.side === 'top', showBottom: P.side === 'bottom', butterfly: false });
+  } catch { /* */ }
+}
+r2w.__r2LadoPeca = (w: string) => r2LadoPeca(w);
+
 /** Mostra o passo na placa: acende a net e leva a câmera ao ponto indicado. */
 function show() {
