+  prev() { guideStore.go(r2w.__r2rp && r2w.__r2rp.on ? guideStore.nextMeasured(-1) : pos - 1); },
+  /* 2R 16/10/2026: REPLAY — rever só os passos já medidos (somente leitura) */
+  nextMeasured(d: number): number {
+    if (!active) return pos;
+    for (let e = pos + d; e >= 0 && e < active.steps.length; e += d) {
