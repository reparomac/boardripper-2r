+    }
+    return pos;
+  },
+  replay(v: boolean): boolean {
+    r2w.__r2rp = { on: !!v };
+    if (v && active) {
+      const e = active.steps.findIndex(t => t.v || t.d || t.r);
+      if (e < 0) { r2w.__r2rp = { on: false }; emit(); return false; }
+      if (!on) guideStore.start();
+      guideStore.go(e);
+    } else emit();
+    return true;
+  },
