 import { bomReasonLabel, type BoardData, type Part } from '../parsers';
 import { pinDisplayId } from '../parsers/types';
 import { setActiveSearchInput, getActiveSearchInput } from './BoardSidebar.utils';
-import { looseMatch } from '../r2/loose-match';
+import { looseMatch, r2Match } from '../r2/loose-match';
 import { IS_2R } from '../r2/env';
 import { mirrorToPdf, searchSyncOn } from '../r2/search-sync';
 
@@ -1115,13 +1115,20 @@ function SearchTab({ tabId }: { tabId: number }) {
 
   // Compute filtered results (show all when no query)
   const ql = query.toLowerCase();
+  // 2R 26/10/2026: busca Exata | Geral da placa — refaz a lista quando a chave muda
+  const [r2x, setR2x] = useState(0);
+  useEffect(() => {
+    const f = () => setR2x(q => q + 1);
+    window.addEventListener('2r-busca-exata', f);
+    return () => window.removeEventListener('2r-busca-exata', f);
+  }, []);
   const matchedParts = useMemo(
-    () => ql ? sortedParts.filter(p => looseMatch(p.name, ql)) : sortedParts,
-    [sortedParts, ql],
+    () => ql ? sortedParts.filter(p => r2Match(p.name, ql)) : sortedParts,
+    [sortedParts, ql, r2x], // eslint-disable-line react-hooks/exhaustive-deps
   );
   const matchedNets = useMemo(
-    () => ql ? sortedNets.filter(([name]) => looseMatch(name, ql)) : sortedNets,
-    [sortedNets, ql],
+    () => ql ? sortedNets.filter(([name]) => r2Match(name, ql)) : sortedNets,
+    [sortedNets, ql, r2x], // eslint-disable-line react-hooks/exhaustive-deps
   );
 
   // Render cap: dense boards have 5–8k parts/nets. Rendering them all
