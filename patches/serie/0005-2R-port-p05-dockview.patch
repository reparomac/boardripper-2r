+/* 2R 27/10/2026 07h26 (Roger: «no meu Mac não abriu desse modo»): placa e PDF lado a lado pela 1ª vez → placa 3/4, PDF 1/4
+   (vale vindo do Acervo 2R, da sessão ou com a placa aberta depois do PDF). window.__r2PdfTerco=false desliga. */
+let _r2PdfLadoK = '';
+function r2PdfLado(e: DockviewApi): void {
+  try {
+    if ((window as unknown as { __r2PdfTerco?: boolean }).__r2PdfTerco === false || !e) return;
+    const b = e.panels.find(a => a.id.startsWith('board-'));
+    const p = e.panels.find(a => a.id.startsWith('pdf-'));
+    if (!b || !p || !b.group || !p.group || b.group === p.group) return;
+    try { if (p.group.api.location.type !== 'grid' || b.group.api.location.type !== 'grid') return; } catch { /* */ }
+    const k = b.group.id + '|' + p.group.id;
+    if (_r2PdfLadoK === k) return;
+    _r2PdfLadoK = k;
+    // 07h32: aplica na hora, sem esperar o desenho do PDF, usando a largura total da área
+    const aj = () => {
+      try {
+        const A = b.group.element.getBoundingClientRect(), B = p.group.element.getBoundingClientRect();
+        const W = A.width || B.width ? Math.abs(B.left - A.left) >= Math.abs(B.top - A.top) : e.width >= e.height;
+        if (W) b.group.api.setSize({ width: Math.round((e.width * 3) / 4) });
+        else b.group.api.setSize({ height: Math.round((e.height * 3) / 4) });
+      } catch { /* */ }
+    };
+    aj();
+    try { requestAnimationFrame(aj); } catch { /* */ }
+    [30, 120, 400, 1200].forEach(t => setTimeout(aj, t));
+  } catch { /* */ }
+}
+
 export function setDockviewApi(api: DockviewApi) {
   _api = api;
+  try { api.onDidAddPanel(() => r2PdfLado(api)); } catch { /* */ }
+  // 07h38 (Roger: «não abre o PDF em 1/4»): o layout salvo «Placa | PDF» move o PDF para um grupo novo logo depois de abrir
+  try { api.onDidMovePanel(() => r2PdfLado(api)); } catch { /* */ }
+  try { api.onDidAddGroup(() => setTimeout(() => r2PdfLado(api), 0)); } catch { /* */ }
   if (_modeUnsubscribe) { _modeUnsubscribe(); _modeUnsubscribe = null; }
