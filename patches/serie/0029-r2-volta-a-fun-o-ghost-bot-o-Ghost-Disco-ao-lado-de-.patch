diff --git a/src/frontend/src/components/overlay/slots/SideSwitch.tsx b/src/frontend/src/components/overlay/slots/SideSwitch.tsx
index 435f83d9..6d372171 100644
--- a/src/frontend/src/components/overlay/slots/SideSwitch.tsx
+++ b/src/frontend/src/components/overlay/slots/SideSwitch.tsx
@@ -4,7 +4,7 @@
  * keyboard's flip shortcut (hold to peek) is unchanged and named in the tip.
  * Moved down from the app toolbar in v0.39; behaviour identical.
  */
-import { IconStackFront, IconStackBack, IconFlipHorizontal } from '@tabler/icons-react';
+import { IconStackFront, IconStackBack, IconFlipHorizontal, IconGhost2, IconGhost2Filled } from '@tabler/icons-react';
 import { boardStore } from '../../../store/board-store';
 import { formatShortcut } from '../../../store/keyboard-shortcuts';
 import type { SlotCtx } from '../slot-ctx';
@@ -14,6 +14,7 @@ export function SideSwitch({ ctx }: { ctx: SlotCtx }) {
   // The store tracks the file's side='top' layer; on files whose primary
   // side is the bottom the labels swap so "Top" means what the user sees.
   const bf = !!t.butterfly;
+  const gm = t.ghostMode ?? 'off';
   const uiTop    = !bf && (t.primarySide === 'bottom' ? t.showBottom : t.showTop);
   const uiBottom = !bf && (t.primarySide === 'bottom' ? t.showTop    : t.showBottom);
   const tip = `${formatShortcut('flipBoard')} flips · hold it to peek · Shift-click for both sides`;
@@ -50,6 +51,22 @@ export function SideSwitch({ ctx }: { ctx: SlotCtx }) {
       >
         <IconFlipHorizontal size={15} stroke={1.9} /><span className="overlay-seg-lbl">Butterfly</span>
       </button>
+      {/* 2R 30/10/2026 (Roger: «voltar a função ghost… botão ao lado do bottom, top, butterfly»): com uma linha
+          marcada, as peças do outro lado nessa linha aparecem apagadas (ghost); segundo clique: disco (as peças da
+          linha piscam nos dois lados); terceiro: desliga */}
+      <button
+        type="button"
+        className={`overlay-seg-btn${gm !== 'off' ? ' active' : ''}${gm === 'disco' ? ' disco-active' : ''}`}
+        data-testid="side-ghost"
+        aria-pressed={gm !== 'off'}
+        title={gm === 'off' ? 'Ghost desligado · clique: peças do outro lado na linha marcada aparecem apagadas'
+          : gm === 'ghosts' ? 'Ghost ligado · clique: disco (peças da linha piscam nos dois lados)'
+          : 'Disco ligado · clique: desliga'}
+        onClick={() => boardStore.cycleGhostMode()}
+      >
+        {gm === 'disco' ? <IconGhost2Filled size={15} stroke={1.9} /> : <IconGhost2 size={15} stroke={1.9} />}
+        <span className="overlay-seg-lbl">{gm === 'disco' ? 'Disco' : 'Ghost'}</span>
+      </button>
     </div>
   );
 }
diff --git a/src/frontend/src/store/board-store.ts b/src/frontend/src/store/board-store.ts
index 3857e86f..ef6b6dbe 100644
--- a/src/frontend/src/store/board-store.ts
+++ b/src/frontend/src/store/board-store.ts
@@ -818,7 +818,8 @@ class BoardStore extends Emitter {
   get showPins(): boolean { return this.activeTab?.showPins ?? true; }
   get showOutlines(): boolean { return this.activeTab?.showOutlines ?? true; }
   get showLabels(): boolean { return this.activeTab?.showLabels ?? true; }
-  get ghostMode(): GhostMode { return 'off'; } // 2R 18/10/2026: sem fantasmas do outro lado
+  // 2R 30/10/2026 (Roger: «voltar a função ghost… botão ao lado do bottom, top, butterfly»): volta a valer o modo da aba
+  get ghostMode(): GhostMode { return this.activeTab?.ghostMode ?? 'off'; }
   get showGhosts(): boolean { return this.ghostMode !== 'off'; }
   get discoHighlight(): boolean { return this.ghostMode === 'disco'; }
   get hideGhosts(): boolean { return this.activeTab?.hideGhosts ?? false; }
