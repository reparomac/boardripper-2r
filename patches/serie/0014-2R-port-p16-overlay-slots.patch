 import { HistoryButtons }   from './slots/HistoryButtons';
 import { MinimapButton, SlideModeButton } from './slots/SlideButtons';
 import { ButterflyButton, RotateCcwButton, RotateCwButton, TracesButton, TransformMenuButton } from './slots/TransformButtons';
+import { R2NetNamesBtn, R2PartNamesBtn } from './slots/R2VisButtons';
 
 /**
  * Returns the rendered ReactNode for a given slot id. Any `sep${number}`
@@ -45,14 +46,39 @@ export function renderOverlaySlot(id: OverlaySlotId, ctx: SlotCtx): ReactNode {
     case 'diodeValues':   return <DiodeValuesButton ctx={ctx} />;
     case 'partsDropdown': return <PartsDropdown ctx={ctx} />;
     case 'netsDropdown':  return <NetsDropdown ctx={ctx} />;
+    case 'netNames':      return <R2NetNamesBtn />;
+    case 'partNames':     return <R2PartNamesBtn />;
   }
 }
 
+// 2R 23/10/2026: legenda curta embaixo de cada botão da faixa (PT / EN / ES)
+const R2CAP: Record<string, [string, string, string]> = {
+  sideSwitch: ['Lado', 'Side', 'Lado'], butterfly: ['Borboleta', 'Butterfly', 'Mariposa'],
+  rotateCCW: ['Girar ◀', 'Rotate ◀', 'Girar ◀'], rotateCW: ['Girar ▶', 'Rotate ▶', 'Girar ▶'],
+  transformMenu: ['Mais', 'More', 'Más'], history: ['Histórico', 'History', 'Historial'], traces: ['Trilhas', 'Traces', 'Pistas'],
+  pdfFollow: ['PDF', 'PDF', 'PDF'], scrollMode: ['Rolagem', 'Scroll', 'Scroll'], fitBoard: ['Ajustar', 'Fit', 'Ajustar'],
+  minimap: ['Mapa', 'Map', 'Mapa'], slides: ['Slides', 'Slides', 'Slides'], hoverInfo: ['Info', 'Info', 'Info'],
+  netDim: ['Foco', 'Focus', 'Foco'], netLines: ['Linhas', 'Lines', 'Líneas'], ghosts: ['Lado B', 'Ghosts', 'Lado B'],
+  diodeValues: ['Diodo', 'Diode', 'Diodo'], netNames: ['Nets', 'Nets', 'Nets'], partNames: ['Comp.', 'Parts', 'Comp.'],
+};
+function r2CapTxt(id: string): string | null {
+  const e = R2CAP[id];
+  if (!e) return null;
+  const t = ((typeof window !== 'undefined' && (window as unknown as { __2rLang?: string }).__2rLang) || 'pt').slice(0, 2);
+  return e[t === 'en' ? 1 : t === 'es' ? 2 : 0];
+}
+
 export function renderOverlayLayout(
   layout: ReadonlyArray<{ id: OverlaySlotId; visible: boolean }>,
   ctx: SlotCtx,
 ): ReactNode[] {
+  // 2R 27/10/2026: «Borboleta» foi para junto de Top/Bottom; o mapa fica sempre à mostra (sem botão)
   return layout
-    .filter(s => s.visible)
-    .map(s => <Fragment key={s.id}>{renderOverlaySlot(s.id, ctx)}</Fragment>);
+    .filter(s => s.visible && s.id !== 'butterfly' && s.id !== 'minimap')
+    .map(s => {
+      const cap = r2CapTxt(s.id);
+      return cap
+        ? <Fragment key={s.id}><span className="r2-capw">{renderOverlaySlot(s.id, ctx)}<span className="r2-cap">{cap}</span></span></Fragment>
+        : <Fragment key={s.id}>{renderOverlaySlot(s.id, ctx)}</Fragment>;
+    });
 }
