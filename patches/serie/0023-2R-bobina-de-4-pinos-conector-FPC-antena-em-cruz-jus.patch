+/** 2R 28/10/2026 (Roger, 820-03285: «outros saindo fora da placa»; mockup aprovado): nada de componente desenhado fora do
+ *  contorno da placa — cada lado (TOP/BOTTOM) ganha uma máscara com o contorno. Só quando o contorno veio do arquivo
+ *  (não o aproximado do R2contorno), é fechado, e pelo menos 98% dos pinos daquele lado estão dentro dele (contorno
+ *  deslocado ou de outra placa não pode esconder peças). window.__r2BordaOff=true desliga. */
+function r2MascaraBorda(board: BoardData, topLayer: Container, bottomLayer: Container): void {
+  try {
+    if (r2win.__r2BordaOff === true || (board as any).__r2contorno) return;
+    const pts = board.outline;
+    if (!pts || pts.length < 4) return;
+    const cs: { x: number; y: number }[][] = [];
+    let cur: { x: number; y: number }[] = [];
+    const flush = () => { if (cur.length >= 3) cs.push(cur); cur = []; };
+    for (const p of pts) { if (isNaN(p.x) || isNaN(p.y)) { flush(); continue; } cur.push(p); }
+    flush();
+    const closed = cs.filter(c => { const a = c[0], z = c[c.length - 1]; return Math.hypot(z.x - a.x, z.y - a.y) < CLOSE_EPS; });
+    if (!closed.length || closed.length !== cs.length) return;
+    const largest = closed.reduce((m, c) => (c.length > m.length ? c : m), closed[0]);
+    if (largest.length < 8) return;
+    const dentro = (x: number, y: number) => {
+      let ins = false;
+      for (const c of closed) {
+        for (let i = 0, j = c.length - 1; i < c.length; j = i++) {
+          const a = c[i], b = c[j];
+          if ((a.y > y) !== (b.y > y) && x < ((b.x - a.x) * (y - a.y)) / (b.y - a.y) + a.x) ins = !ins;
+        }
+      }
+      return ins;
+    };
+    const bb = (c: { x: number; y: number }[]) => computeBBox(c);
+    const LB = bb(largest);
+    const pecas = closed.filter(c => c === largest || (() => { const b = bb(c); return !(b.minX >= LB.minX && b.maxX <= LB.maxX && b.minY >= LB.minY && b.maxY <= LB.maxY); })());
+    for (const [lado, layer] of [['top', topLayer], ['bottom', bottomLayer]] as const) {
+      let n = 0, ok = 0;
+      for (const part of board.parts) {
+        if ((part as any).side !== lado) continue;
+        for (const q of part.pins) { n++; if (dentro(q.position.x, q.position.y)) ok++; }
+      }
+      if (n < 20 || ok / n < 0.98) continue;
+      const g = new Graphics();
+      g.label = 'r2-mascara-borda-' + lado;
+      for (const c of pecas) { g.poly(c, true); g.fill({ color: 0xffffff }); }
+      layer.addChild(g);
+      layer.mask = g;
+    }
+  } catch { /* sem máscara */ }
+}
