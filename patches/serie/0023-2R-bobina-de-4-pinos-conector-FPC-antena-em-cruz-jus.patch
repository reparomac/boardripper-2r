+/*2R 28/10/2026 (print do Roger, L8111/L8112/L8241 da 820-03285 — «as bobinas estão maiores»; mockup aprovado: «os pads… prefiro manter único, não nos cantos, mas pode alterar o tamanho»): bobina dupla de 4 pinos em 2×2 (dois pinos de um lado, dois do outro). Um pad único por lado (os dois pinos do mesmo lado juntos, ao longo do lado curto) e o corpo justo em volta dos pinos, com a redução das bobinas de 2 pinos. window.__r2Bob4Off=true desliga*/ function R2bob4(b) {
+  if (!b || !b.parts || window.__r2Bob4Off === !0) return;
+  for (const P of b.parts) {
+    try {
+      if (!P || !P.pins || P.pins.length !== 4 || !/^L/i.test(P.name || "") || P.__r2shunt || P.__r2pads) continue;
+      if (P.pins.some((q) => !q || !q.position || q.padBounds)) continue;
+      const xs = P.pins.map((q) => q.position.x), ys = P.pins.map((q) => q.position.y);
+      const x0 = Math.min(...xs), x1 = Math.max(...xs), y0 = Math.min(...ys), y1 = Math.max(...ys);
+      const dx = x1 - x0, dy = y1 - y0;
+      if (!(dx > 0 && dy > 0)) continue;
+      const tx = dx * 0.1, ty = dy * 0.1;
+      if (!P.pins.every((q) => (Math.abs(q.position.x - x0) < tx || Math.abs(q.position.x - x1) < tx) && (Math.abs(q.position.y - y0) < ty || Math.abs(q.position.y - y1) < ty))) continue;
+      const vert = dy <= dx; /*lado curto na vertical: cada lado (esquerdo/direito) tem 2 pinos empilhados*/
+      const s = vert ? dy : dx, l = vert ? dx : dy;
+      const rq = Math.max(...P.pins.map((q) => q.radius || 0));
+      const r = Math.min(rq > 0 ? rq : s * 0.35, s * 0.4, l * 0.3);
+      const a = r * 0.6, h = s / 2 + r * 0.8; /*pad: meia largura (lado longo) e meio comprimento (lado curto)*/
+      const cx = (x0 + x1) / 2, cy = (y0 + y1) / 2;
+      for (const q of P.pins) {
+        const left = vert ? q.position.x < cx : q.position.y < cy;
+        const c = vert ? (left ? x0 : x1) : (left ? y0 : y1);
+        q.padBounds = vert
+          ? { minX: c - a, minY: cy - h, maxX: c + a, maxY: cy + h }
+          : { minX: cx - h, minY: c - a, maxX: cx + h, maxY: c + a };
+        delete q.padShape;
+        delete q.padWidth; delete q.padHeight; delete q.padAngleDeg; delete q.padPolygon; delete q.padCornerRadius;
+      }
+      const eL = r * 0.8, eS = r * 0.9;
+      P.__r2corpo = vert
+        ? { x: x0 - eL, y: y0 - eS, w: dx + 2 * eL, h: dy + 2 * eS }
+        : { x: x0 - eS, y: y0 - eL, w: dx + 2 * eS, h: dy + 2 * eL };
+      P.__r2shunt = 1;
+      P.__r2pads = 1;
+    } catch (e) {}
+  }
+}
+/*2R 28/10/2026 (print do Roger, J5150 da 820-03285; mockup aprovado): conector FPC / placa-placa de duas fileiras (J…, 8 pinos ou mais). O corpo do arquivo ficava só entre as fileiras, com os pads pequenos para fora. Agora: pads finos na medida do passo (0,6 do passo) e um pouco mais compridos, pinos de fixação soltos no meio viram pads retangulares maiores, e o corpo cobre as duas fileiras com 0,15 mm de folga. window.__r2FpcOff=true desliga*/ function R2fpc(P, U, p) {
+  try {
+    if (window.__r2FpcOff === !0 || !/^J/i.test(P.name || "") || P.pins.length < 8) return;
+    const fil = U.filter((u) => !u.mid && u.n === 1);
+    if (fil.length < 6) return;
+    const hz = fil.filter((u) => u.h && !u.v).length, vt = fil.filter((u) => u.v && !u.h).length;
+    const o = hz >= vt ? "h" : "v";
+    const key = (u) => Math.round((o === "h" ? u.y : u.x) / Math.max(p * 0.5, 1e-6));
+    const rows = new Map();
+    for (const u of fil) rows.set(key(u), (rows.get(key(u)) || 0) + 1);
+    const big = [...rows.entries()].filter((e) => e[1] >= 3).map((e) => e[0]).sort((a, b) => a - b);
+    if (big.length !== 2) return;
+    const cs = fil.filter((u) => big.includes(key(u))).map((u) => (o === "h" ? u.y : u.x));
+    const r0 = Math.min(...cs), r1 = Math.max(...cs), gap = r1 - r0;
+    if (!(gap > p)) return;
+    const S = p * 0.6, L = Math.min(p * 1.6, gap * 0.35);
+    for (const u of fil) {
+      if (!big.includes(key(u))) continue;
+      for (const q of u.pins) {
+        q.padBounds = o === "h"
+          ? { minX: u.x - S / 2, minY: u.y - L / 2, maxX: u.x + S / 2, maxY: u.y + L / 2 }
+          : { minX: u.x - L / 2, minY: u.y - S / 2, maxX: u.x + L / 2, maxY: u.y + S / 2 };
+        delete q.padShape;
+      }
+    }
+    for (const u of U) {
+      if (!u.mid) continue;
+      const ha = p * 0.65, hb = Math.min(gap * 0.26, p * 2);
+      for (const q of u.pins) {
+        q.padBounds = o === "h"
+          ? { minX: u.x - ha, minY: u.y - hb, maxX: u.x + ha, maxY: u.y + hb }
+          : { minX: u.x - hb, minY: u.y - ha, maxX: u.x + hb, maxY: u.y + ha };
+        delete q.padShape;
+      }
+    }
+    let a0 = 1 / 0, b0 = 1 / 0, a1 = -1 / 0, b1 = -1 / 0;
+    for (const q of P.pins) {
+      const B = q.padBounds;
+      if (!B) continue;
+      a0 = Math.min(a0, B.minX); b0 = Math.min(b0, B.minY); a1 = Math.max(a1, B.maxX); b1 = Math.max(b1, B.maxY);
+    }
+    if (!isFinite(a0)) return;
+    const g = 0.15 * 39.37;
+    P.__r2corpo = { x: a0 - g, y: b0 - g, w: a1 - a0 + 2 * g, h: b1 - b0 + 2 * g };
+  } catch (e) {}
+}
 function R2pads(b) {
   /*2R 20/10/2026 (Roger): «todos os pads como no componente físico» — o arquivo só traz o centro do pino; o formato é deduzido: pinos de borda em fila viram pads retangulares (com folga entre eles), vários pinos no mesmo ponto viram um pad de potência maior e pino solto no meio fica redondo. BGA (grade) continua redondo. Liga/desliga: window.__r2PadsOff*/ if (
     !b ||
@@ -1580,6 +1662,7 @@ function R2pads(b) {
         for (const q of u.pins) q.padBounds = { minX: u.x - L, minY: u.y - T, maxX: u.x + Rr, maxY: u.y + Bb };
       }
     }
+    R2fpc(P, U, p);
     P.__r2shunt = 1;
     P.__r2pads = 1;
   }
@@ -1824,4 +1907,4 @@ function R2pads(b) {
   } catch (e) {}
 }
 
