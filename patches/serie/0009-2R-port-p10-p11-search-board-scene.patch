+    }
+    /*08h22 (Roger: «vai se orientar pelos pinos de 1 a 8… sobrepõe o desenho do chip… a partir daí redireciona os pinos seguindo o mesmo padrão dos outros iguais… só depois faz o contorno»): o ângulo vem da fileira dos pinos 1→8 (reta pelos 8 pinos); a fileira de vizinhos fica só de reserva*/ let g18 =
+      null;
+    {
+      const pn = (n) => P.pins.find((q) => String(q.number ?? q.name ?? "") === String(n));
