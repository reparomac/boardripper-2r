+/*2R 20/10/2026 (Roger): pad pequeno ou net selecionada → card do diodo ao lado do pad, virado para dentro do componente (fora quando o componente é pequeno), para o pad ficar à mostra*/ function R2centro(
+  p,
+  k,
+) {
+  if (p.__r2cx == null) {
+    let x = 0,
+      y = 0,
+      n = 0;
+    for (const q of p.pins) q.position && ((x += q.position.x), (y += q.position.y), n++);
+    ((p.__r2cx = n ? x / n : 0), (p.__r2cy = n ? y / n : 0));
+  }
+  return k ? p.__r2cy : p.__r2cx;
+}
+function R2viz(p, q) {
+  if (q.__r2nn == null) {
+    let d = 1 / 0;
+    for (const o of p.pins)
+      if (o !== q && o.position) {
+        const e = Math.hypot(o.position.x - q.position.x, o.position.y - q.position.y);
+        e > 0 && e < d && (d = e);
+      }
+    q.__r2nn = isFinite(d) ? d : 0;
+  }
+  return q.__r2nn;
+}
+function R2tam(b, m, t, C) {
+  /*2R 21/10/2026 (Roger): medição só da linha que está medindo (selecionada) ou do chip selecionado; o resto some. Cards pequenos DENTRO do pad; card maior ao lado só nos pinos da linha selecionada e só se couber no vão entre os pads (sem cobrir o vizinho)*/ b.__side =
+    !1;
+  if (/^[\s\-–—]*$/.test(String(b.text ?? ""))) return 0;
+  if (!b.pad || b.px == null) return C;
+  /*2R 24/10/2026 22h30: o raio do ajuste pode ser maior que o pad desenhado (BGA denso) — limita pela distância até o pino vizinho, para o card nunca passar do pad nem encostar no vizinho*/ const r =
+      Math.min(b.pad, b.nn ? b.nn * 0.46 : b.pad) * t.scale,
+    k =
+      0.6 * Math.max(5, String(b.text).length) +
+      1.1 /*2R 24/10/2026 (Roger: «fora de padrão os tamanhos dos cards»): todo card com a largura de 5 caracteres (0.000); OL não cresce*/,
+    S = U.selection || {},
+    lin = b.net != null && S.highlightedNet === b.net,
+    peca = S.partIndex != null && S.partIndex === b.partIndex,
+    dentro = Math.max(3, Math.min(C, (r * 2 * 0.92) / k));
+  if (!lin && !peca) {
+    /*lente ligada: mostra os valores dos pinos que estão sob a lente (21/10/2026)*/ const L = window.__r2Lente;
+    if (L) {
+      const lx = m.a * b.px + m.c * b.py + m.tx,
+        ly = m.b * b.px + m.d * b.py + m.ty;
+      if (Math.hypot(lx - L.x, ly - L.y) <= L.r) return dentro;
+    }
+    /*2R 24/10/2026 (Roger, igual ao FlexBV): sem poluir — o card só aparece quando o zoom deixa a letra legível DENTRO do pad; por isso os componentes grandes aparecem primeiro, depois os médios e os pequenos. Mínimo em localStorage «2r-obd-min» (px, padrão 7); window.__r2ObdZoomOff=true volta à regra antiga (só linha/peça/lente)*/ if (
+      window.__r2ObdZoomOff === !0
+    )
+      return 0;
+    let mn = 7;
+    try {
+      mn = parseFloat(localStorage.getItem("2r-obd-min") || "7") || 7;
+    } catch {}
+    return dentro >= mn && (r * 2 * 0.92) / k >= mn ? dentro : 0;
+  }
+  if (!lin) {
+    /*2R 24/10/2026 22h25 (Roger: «ainda está poluído… quando tem muitos pads, só aparecer a leitura OBD quando tiver muito zoom e card pequeno»): no componente selecionado vale a mesma regra — o card só aparece quando cabe legível DENTRO do pad*/ let mn2 = 7;
+    try {
+      mn2 = parseFloat(localStorage.getItem("2r-obd-min") || "7") || 7;
+    } catch {}
+    return (r * 2 * 0.92) / k >= mn2 ? dentro : 0;
+  }
+  if (!b.nn) return ((b.__side = !0), C);
+  const x = m.a * b.px + m.c * b.py,
+    y = m.b * b.px + m.d * b.py,
+    cx = m.a * b.cx + m.c * b.cy,
+    cy = m.b * b.cx + m.d * b.cy,
+    p = b.nn * t.scale,
+    g = p - 2 * r - 8,
+    hor = Math.abs(cx - x) >= Math.abs(cy - y),
+    fora = hor ? Math.min(C, g / k, (p - 4) / 1.6) : Math.min(C, g / 1.6, (p - 4) / k);
+  return fora <= dentro * 1.1 ? dentro : ((b.__side = !0), fora);
+}
+function R2lado(b, m, t, G, N) {
+  if (!b.pad || b.px == null) return null;
+  if (!b.__side) return null;
+  const r = b.pad * t.scale,
+    w = G + N * 1.1,
+    h = N * 1.6;
+  const x = m.a * b.px + m.c * b.py + m.tx,
+    y = m.b * b.px + m.d * b.py + m.ty,
+    cx = m.a * b.cx + m.c * b.cy + m.tx,
+    cy = m.b * b.cx + m.d * b.cy + m.ty,
+    dx = cx - x,
+    dy = cy - y,
+    d = Math.hypot(dx, dy),
+    s = d > r + w + 6 ? 1 : -1;
+  return Math.abs(dx) >= Math.abs(dy)
+    ? [x + s * (dx < 0 ? -1 : 1) * (r + w / 2 + 4), y]
+    : [x, y + s * (dy < 0 ? -1 : 1) * (r + h / 2 + 4)];
+}
+/*2R 24/10/2026 21h30 (Roger: «no BDV colocar um ponto de referência, duas linhas cruzadas… sempre manter centralizado com essas duas linhas… padrão em tudo que usa o BDV»): cruz fina no centro da placa, de borda a borda, só referência (não pega clique). localStorage «2r-mira»="0" esconde*/ function R2mira(
+  el,
+) {
+  try {
+    if (!el || el.querySelector(":scope>.r2-mira")) return;
+    if (getComputedStyle(el).position === "static") el.style.position = "relative";
+    const d = document.createElement("div");
+    d.className = "r2-mira";
+    /*09h19 (Roger: «dentro da placa pode deixar mais claro a linha e fora dela mais escura»): a linha usa «diferença» — sobre a placa escura fica cinza-claro, sobre a mesa cinza-clara fica cinza-escuro*/ d.style.cssText =
+      "position:absolute;inset:0;pointer-events:none;z-index:6;mix-blend-mode:difference";
+    const L = "position:absolute;background:rgb(150,150,150)";
+    d.innerHTML =
+      '<i style="' +
+      L +
+      ';left:0;right:0;top:50%;height:1px;transform:translateY(-.5px)"></i><i style="' +
+      L +
+      ';top:0;bottom:0;left:50%;width:1px;transform:translateX(-.5px)"></i>';
+    const up = () => {
+      let on = !0;
+      try {
+        on = localStorage.getItem("2r-mira") !== "0";
+      } catch {}
+      d.style.display = on ? "" : "none";
+    };
+    up();
+    window.addEventListener("storage", up);
+    window.__r2Mira = (v) => {
+      try {
+        localStorage.setItem("2r-mira", v ? "1" : "0");
+      } catch {}
+      up();
+    };
+    el.appendChild(d);
+  } catch {}
+}
+/*2R 24/10/2026 (Roger: «alguns CI estão com falha no contorno… acontece em todos»): o contorno do componente passa a envolver TODOS os pads (o retângulo do arquivo às vezes fica deslocado ou menor que os pads); CI (mais de 4 pinos) com contorno branco, no padrão dos cards. window.__r2CaixaOff=true / __r2CiBranco=false desligam*/ /*2R 27/10/2026 08h24 (print do Roger: U1200, U7800 e U3900 ainda com folga): bola de BGA sem tamanho no arquivo (raio 0) — o desenho usa ~0,45 do passo entre bolas; a margem passa a medir a partir dessa borda. Calculado uma vez por componente*/ function R2raio(
+  P,
+) {
+  if (P.__r2pr !== void 0) return P.__r2pr;
+  P.__r2pr = 0;
+  try {
+    const pts = P.pins.filter((q) => q && q.position).map((q) => q.position),
+      N = Math.min(pts.length, 150);
+    let pm = 1 / 0;
+    for (let i = 0; i < N; i++)
+      for (let j = 0; j < pts.length; j++) {
+        if (i === j) continue;
+        const d = Math.hypot(pts[i].x - pts[j].x, pts[i].y - pts[j].y);
+        d > 1e-6 && d < pm && (pm = d);
+      }
+    isFinite(pm) && (P.__r2pr = pm * 0.45);
+  } catch {}
+  return P.__r2pr;
+}
+/*08h31 (Roger: «não aplicou a margem de 0,05 mm no U1200, U7800 e U3900»): o raio que vem no arquivo é maior que a bola desenhada (a tela limita a bola a ~0,45 do passo) — a margem contava a partir desse raio grande. Agora usa o menor dos dois = a bola que aparece*/ function R2rEf(
+  P,
+  q,
+) {
+  const rp = R2raio(P),
+    rq = (q && q.radius) || 0;
+  return rq > 0 && rp > 0 ? Math.min(rq, rp) : rq || rp || 0;
+}
+function R2caixa(P, a) {
+  /*2R 24/10/2026 22h (Roger: «acender só o contorno já existente, sem precisar criar um novo contorno»): desligado por padrão; window.__r2CaixaOn=true religa*/ /*2R 27/10/2026 (Roger: «revisa nos BDV, tem muito CI com o contorno cortado»): volta a valer sozinho para CI e transistores (3 pinos ou mais; Roger: «tá cortado também… QK e UK») — só mexe quando algum pad sai do contorno do arquivo; aí o contorno cresce até envolver todos os pads (com contorno inclinado, vira o retângulo que envolve tudo). Os outros componentes continuam com o contorno do arquivo*/ /*27/10 07h13 (Roger: «os contornos que estavam errados nos CIs, eu pedi para arrumar... esses mantém»): continua ligado para CI/transistor*/ if (
+    window.__r2CaixaOff === !0 ||
+    !P ||
+    !P.pins ||
+    P.pins.length < 3 ||
+    !/^[UQ]/i.test(P.name || "")
+  )
+    return a;
+  /*27/10 07h38 (print do Roger: capacitores de 220UF/2V, que têm 3 ou mais pinos, cresciam e encavalavam): só CI (U…) e transistor (Q…); capacitor, bobina, resistor e o resto ficam sempre no tamanho do arquivo*/ const R2a0 =
+    a;
+  if (a.poly) {
+    let px0 = 1 / 0,
+      py0 = 1 / 0,
+      px1 = -1 / 0,
+      py1 = -1 / 0;
+    for (const v of a.poly) {
+      px0 = Math.min(px0, v[0]);
+      py0 = Math.min(py0, v[1]);
+      px1 = Math.max(px1, v[0]);
+      py1 = Math.max(py1, v[1]);
+    }
+    a = { ...a, x: px0, y: py0, w: px1 - px0, h: py1 - py0, __p: a.poly };
+  }
+  let x0 = 1 / 0,
+    y0 = 1 / 0,
+    x1 = -1 / 0,
+    y1 = -1 / 0;
+  for (const q of P.pins) {
+    if (!q || !q.position) continue;
+    const b = q.padBounds,
+      r = R2rEf(P, q);
+    x0 = Math.min(x0, b ? b.minX : q.position.x - r);
+    y0 = Math.min(y0, b ? b.minY : q.position.y - r);
+    x1 = Math.max(x1, b ? b.maxX : q.position.x + r);
+    y1 = Math.max(y1, b ? b.maxY : q.position.y + r);
+  }
+  if (!isFinite(x0) || !isFinite(x1)) return R2a0;
+  const m = 0; /*27/10 07h50 (Roger: «os contornos dos CI estão passando por cima dos resistores»): sem folga — o contorno encosta na borda do pad*/
+  x0 -= m;
+  y0 -= m;
+  x1 += m;
+  y1 += m;
+  /*2R 27/10/2026 07h54 (Roger: «cria uma regra para a margem ficar tantos mm dos contornos dos pads»): CI (U…) e transistor (Q…) — o contorno é o retângulo que envolve todos os pads + a margem fixa em mm de cada lado (encolhe o contorno grande do arquivo e cresce o que cortava pad). Margem: localStorage «2r-ci-margem-mm» (padrão 0,15 mm; o arquivo está em mils: 1 mm = 39,37 mils). Componente com contorno inclinado mantém a regra antiga. window.__r2CiJusto=false volta ao contorno do arquivo*/ if (
+    window.__r2CiJusto !== !1 &&
+    (!a.__p || !P.__r2gira) /*08h24: vale também quando o contorno do arquivo vem como polígono (chip reto)*/
+  ) {
+    let mm = 0.05; /*27/10 08h33 (print do Roger: U3650, U3640, U3830, U3820, U3810 — «os componentes pequenos também estão com a margem grande, aplica a regra dos 0,05 mm»)*/
+    try {
+      const v = parseFloat(String(localStorage.getItem("2r-ci-margem-mm") || "").replace(",", "."));
+      isFinite(v) && v >= 0 && v <= 5 && (mm = v);
+    } catch {}
+    const g = R2margem(P, mm) * 39.37,
+      { __p: _q2, poly: _o2, ...o2 } = a;
+    return { ...o2, x: x0 - g, y: y0 - g, w: x1 - x0 + 2 * g, h: y1 - y0 + 2 * g };
+  }
+  if (x0 >= a.x - 1e-6 && y0 >= a.y - 1e-6 && x1 <= a.x + a.w + 1e-6 && y1 <= a.y + a.h + 1e-6)
+    return a === R2a0 || a.__p ? R2a0 : a;
+  const nx = Math.min(x0, a.x),
+    ny = Math.min(y0, a.y),
+    mx = Math.max(x1, a.x + a.w),
+    my = Math.max(y1, a.y + a.h),
+    { __p: _q, poly: _o, ...o } = a;
+  return { ...o, x: nx, y: ny, w: mx - nx, h: my - ny };
+}
+/*2R 20/10/2026 (Roger): contorno de todo componente na cor do próprio componente, um tom mais claro*/ function R2claro(
+  h,
+) {
+  const v = parseInt(String(h).replace("#", ""), 16);
+  if (!isFinite(v)) return null;
+  const f = (c) => Math.round(c + (255 - c) * 0.38);
+  return (f((v >> 16) & 255) << 16) | (f((v >> 8) & 255) << 8) | f(v & 255);
+}
+/*2R 27/10/2026 08h03 (print do Roger, U7410 da A2141: «precisa fazer o desenho do chip, está num ângulo de 45 graus»): CI (U…) ou transistor (Q…) montado girado — o retângulo do arquivo fica reto e enorme, cobrindo os vizinhos. O ângulo vem das fileiras de pinos (direção do pino vizinho mais próximo, em pelo menos metade dos pinos); se for inclinado (entre 10° e 80°), o contorno vira esse retângulo girado (pads + a mesma margem em mm dos outros CIs). window.__r2GiraCiOff=true desliga*/ /*2R 27/10/2026 08h13 (Roger: «o U7410… é só ver a pinagem igual aos outros do lado, são do mesmo modelo»): DrMOS PQFN 31L montado girado (ex.: U7410 da A2141, a 45°). O molde só encaixava em 0/90/180/270°: aqui o ângulo vem das fileiras de pinos, os pinos são «desgirados» só para o encaixe, e os pads e o corpo do molde voltam girados (polígonos). window.__r2GiraCiOff=true desliga*/ function R2drmosGiro(
+  P,
+) {
+  try {
+    if (
+      window.__r2GiraCiOff === !0 ||
+      !P ||
+      !P.pins ||
+      P.pins.length < 12 ||
+      P.pins.length > 34 ||
+      !/^U/i.test(P.name || "")
+    )
+      return !1;
+    const pts = P.pins.filter((q) => q && q.position).map((q) => q.position);
+    if (pts.length !== P.pins.length) return !1;
+    const H = new Map();
+    for (let i = 0; i < pts.length; i++) {
+      let m = 1 / 0,
+        dx = 0,
+        dy = 0;
+      for (let j = 0; j < pts.length; j++) {
+        if (i === j) continue;
+        const x = pts[j].x - pts[i].x,
+          y = pts[j].y - pts[i].y,
+          d2 = x * x + y * y;
+        d2 > 1e-9 && d2 < m && ((m = d2), (dx = x), (dy = y));
+      }
+      if (m < 1 / 0) {
+        let g = Math.round((Math.atan2(dy, dx) * 180) / Math.PI);
+        g = ((g % 90) + 90) % 90;
+        H.set(g, (H.get(g) || 0) + 1);
+      }
+    }
+    let gd = 0,
+      gn = 0;
+    for (const [g, n] of H) {
