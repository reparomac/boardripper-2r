   name?: string; iv?: string; id?: string; ir?: string; star?: boolean;
@@ -436,7 +437,7 @@ export const guideStore = {
     const steps = active.steps.map((st, k) => (k === i ? { ...st, ...patch } : st));
     replaceActive(steps);
     if (r2w.__r2Anot) r2w.__r2Anot(active, i, patch);
-    const onlyValues = Object.keys(patch).every(k => ['v', 'd', 'r', 'valBy', 'valAt', 'note'].includes(k));
+    const onlyValues = Object.keys(patch).every(k => ['v', 'd', 'r', 'valBy', 'valAt', 'note', 'vs', 'ds', 'rs'].includes(k));
     if (i === pos && !onlyValues) { pointIdx = 0; if (on) show(); }
   },
   /** Fixa o pino selecionado na placa como o ponto do passo atual. */
@@ -500,13 +501,13 @@ export const guideStore = {
     return label;
   },
   /** Leitura do instrumento com a sequência ligada: preenche a coluna do modo no passo atual. */
-  recordValue(mode: 'tensao' | 'diodo' | 'resistencia', value: number, unit: string, by = ''): boolean {
+  recordValue(mode: 'tensao' | 'diodo' | 'resistencia', value: number, unit: string, by = '', src = ''): boolean {
     if (!on || !active || !active.steps[pos] || (r2w.__r2rp && r2w.__r2rp.on)) return false;
     const key = mode === 'tensao' ? 'v' : mode === 'diodo' ? 'd' : 'r';
     // 2R 26/10/2026: valores no padrão do SDS (vírgula, V com 2 casas) — window.__r2Num vem do index.html
     const txt = r2w.__r2Num ? r2w.__r2Num(key, String(value)) : mode === 'resistencia' ? fmtOhm(value) : value.toFixed(3);
     void unit;
-    guideStore.editStep(pos, { [key]: txt as string, valBy: by, valAt: Date.now() } as Partial<Step>);
+    guideStore.editStep(pos, { [key]: txt as string, [key + 's']: src || undefined, valBy: by, valAt: Date.now() } as Partial<Step>);
     return true;
   },
   // ── programar os pontos a medir (Roger, 11/10/2026): clicar/buscar na placa e no PDF,
