 .r2gd-cell.has { color: var(--r2-strong); font-weight: 700; }
 .r2gd-hud-vals { display: flex; justify-content: center; gap: 14px; font-size: 12px; color: var(--r2-mute); margin-top: 3px; }
 .r2gd-hud-vals b { color: var(--r2-strong); font-family: ui-monospace, Menlo, monospace; }
+/* 2R 30/10/2026: aparelho que gravou cada valor e quem está capturando agora */
+.r2gd-hud-src { font-style: normal; font-size: 10.5px; color: #E0A040; margin-left: 4px; }
+.r2gd-hud-cap { display: flex; justify-content: center; gap: 12px; font-size: 11.5px; margin-top: 4px; }
