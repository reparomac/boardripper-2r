@@ -0,0 +1,41 @@
+import { useSyncExternalStore } from 'react';
+import { guideStore } from '../r2/guide-store';
+import { useBoardStore } from '../hooks/useBoardStore';
+import { boardStore } from '../store/board-store';
+import { bgaBall } from '../r2/bga';
+
+/** 2R Tools: faixa do Teleguiado em cima da placa — passo atual, net, ponto indicado e setas. */
+export function GuideHud() {
+  useSyncExternalStore(guideStore.subscribe, () => guideStore.rev);
+  useBoardStore();
+  const a = guideStore.active;
+  if (!guideStore.on || !a) return null;
+  const r = guideStore.current();
+  if (!r) return null;
+  const pt = r.points.length ? r.points[guideStore.pointIdx % r.points.length] : null;
+  const tab = boardStore.activeTab, sel = tab?.selection;
+  const sp = tab?.board && sel?.partIndex != null && sel.pinIndex != null && sel.pinIndex >= 0 ? tab.board.parts[sel.partIndex] : null;
+  const selLabel = sp ? `${sp.name}.${sp.pins[sel!.pinIndex!].number || sp.pins[sel!.pinIndex!].name}` : '';
+  const ball = pt && tab?.board ? bgaBall(tab.board.parts[pt.partIndex], pt.pinIndex) : null;
+  const canFix = !!selLabel && selLabel.toUpperCase() !== (r.step.point || '').toUpperCase() && (!pt || selLabel !== pt.label);
+  return (
+    <div className="r2gd-hud">
+      <button className="r2gd-hud-arrow" title="Passo anterior (←)" onClick={() => guideStore.prev()} disabled={guideStore.pos === 0}>‹</button>
+      <div className="r2gd-hud-body">
+        <div className="r2gd-hud-top">{a.title} · passo {r.step.n} de {a.steps[a.steps.length - 1].n}{a.credit ? ` · créditos: ${a.credit}` : ''}</div>
+        <div className="r2gd-hud-net">{r.step.nets.join(' · ')}</div>
+        <div className="r2gd-hud-sub">
+          {pt ? <>medir em <b>{pt.fixed ? '◆ ' : ''}{pt.label}</b>{r.points.length > 1 ? ` (Tab: ${r.points.length - 1} outro${r.points.length > 2 ? 's' : ''})` : ''}</>
+            : r.missing.length ? <span className="r2gd-miss">não achei «{r.missing.join(', ')}» nesta placa</span> : 'sem ponto acessível nessa net'}
+          {r.step.note && <span className="r2gd-hud-note"> · {r.step.note}</span>}
+        </div>
+        {ball && <div className="r2gd-hud-bga" title={`BGA ${ball.rows} linhas × ${ball.cols} colunas`}>
+          BGA · bola <b>{ball.ball}</b> — linha {ball.row}, coluna {ball.col}{ball.approx ? ' (contando do canto do pino 1)' : ''}</div>}
+        {(r.step.v || r.step.d || r.step.r) && <div className="r2gd-hud-vals">
+          <span>Tensão <b>{r.step.v || '—'}</b></span><span>Diodo <b>{r.step.d || '—'}</b></span><span>Resist. <b>{r.step.r || '—'}</b></span></div>}
+        {canFix && <button className="r2gd-hud-fix" onClick={() => guideStore.pinSelectedAsPoint()}>◆ usar {selLabel} como ponto deste passo</button>}
+      </div>
+      <button className="r2gd-hud-arrow" title="Próximo passo (→)" onClick={() => guideStore.next()} disabled={guideStore.pos >= a.steps.length - 1}>›</button>
+    </div>
+  );
+}
