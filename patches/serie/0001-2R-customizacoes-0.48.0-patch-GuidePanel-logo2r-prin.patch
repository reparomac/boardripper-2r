@@ -0,0 +1,24 @@
+/** 2R Tools: o BoardRipper está rodando dentro do app 2R Tools (SDS)?
+ *  O app injeta `window.__2rAcervo` antes da página carregar. */
+export interface R2Acervo {
+  list(q: string): Promise<{ rows: R2Row[]; boards: number; pdfs: number; ready: boolean }>;
+  open(id: string): Promise<{ ok?: boolean; pdf?: boolean; error?: string }>;
+  known(): Promise<{ boards: Record<string, { mac_model: string; emc: string; model_name: string; year: string }>;
+                     models: Record<string, string>; credit: string; ext: string[] }>;
+  upload(file: File, fields: Record<string, string>): Promise<{ ok?: boolean; error?: string; detail?: string }>;
+}
+export interface R2Row { id: string; kind: 'board' | 'pdf'; name: string; folder: string; pdf: boolean; by?: string }
+
+export function r2(): R2Acervo | null {
+  const w = (typeof window !== 'undefined' ? window : undefined) as unknown as { __2rAcervo?: R2Acervo } | undefined;
+  return w?.__2rAcervo ?? null;
+}
+export const IS_2R = r2() !== null;
+
+/** Funções Beta que o app liga/desliga em Configurações › Ferramentas › Boardview
+ *  (Roger, 10/10/2026: «marcar como beta e a gente desativa no painel»).
+ *  Sem o app (navegador), tudo ligado. */
+export function beta(key: 'medicoes' | 'curvas' | 'teleguiado' | 'mcp'): boolean {
+  const b = (typeof window !== 'undefined' ? (window as unknown as { __2rBeta?: Record<string, boolean> }).__2rBeta : undefined);
+  return !b || b[key] !== false;
+}
diff --git a/src/frontend/src/r2/guide-store.ts b/src/frontend/src/r2/guide-store.ts
new file mode 100644
index 00000000..425e0959
--- /dev/null
+++ b/src/frontend/src/r2/guide-store.ts
@@ -0,0 +1,512 @@
+/**
+ * 2R Tools: Teleguiado — sequência de start indicada na placa (Roger, 10/10/2026):
+ * «deixar o boardripper com a função teleguiado… uma sequência de start e já
+ *  indicar os pontos na placa-mãe… em cima de um texto, converter… com a função
+ *  ativada, as setas do teclado vão alternando os pontos na sequência».
+ *
+ * Texto aceito (exemplo do Roger, M1 820-02020):
+ *   M1 820-02020
+ *   01 USBC0_CC1
+ *   14 MPMU_XOUT,MPMU-XIN (32.768KHz) (ELE MANDA O MESMO CLOCK PARA U7700)
+ * 1ª linha sem número = título (o 820-xxxxx liga o roteiro à placa aberta).
+ * Cada linha numerada = um passo; nomes separados por vírgula; o que está entre
+ * parênteses vira observação.
+ */
+import { boardStore } from '../store/board-store';
+import { pdfStore } from '../store/pdf-store';
+import type { BoardData } from '../parsers/types';
+import { IS_2R, beta } from './env';
+
+export interface Step { n: number; nets: string[]; note: string; raw: string; /** ponto escolhido à mão (ex.: «C7033.1») */ point?: string;
+  /** valores do passo (Roger: «add mais 3 colunas, como tensão, modo diodo e resistência… editável durante a
+   *  leitura dos pontos, pelos instrumentos ou manualmente») — texto como o técnico escreve */
+  v?: string; d?: string; r?: string; /** quem/quando preencheu pelo instrumento */ valBy?: string; valAt?: number;
+  /** Ponto a ponto (Roger, 11/10/2026): nome do teste (renomeável), valor certo (ideal) e a estrela
+   *  do «valor certo depois do reparo» (vira referência). */
+  name?: string; iv?: string; id?: string; ir?: string; star?: boolean }
+export interface Roteiro { id: string; title: string; board: string; steps: Step[]; created: number; by?: string; models?: string[]; builtin?: boolean;
+  /** créditos: quem montou a sequência (Roger: «colocar os créditos para o dono da sequência de start») */
+  credit?: string; upd?: number;
+  /** start = sequência de start; analise = sequência de análise montada pelo técnico */
+  kind?: 'start' | 'analise' }
+export interface Point { partIndex: number; pinIndex: number; label: string; kind: 'capacitor' | 'resistor' | 'bobina' | 'teste' | 'outro'; fixed?: boolean }
+export interface Resolved { step: Step; nets: string[]; missing: string[]; points: Point[] }
+
+// Sequência de start do M1 enviada pelo Roger (10/10/2026), que pediu para deixar
+// no A2337 (MacBook Air M1, 820-02016) e no A2338 (MacBook Pro 13 M1, 820-02020).
+// Conferida contra os boardviews reais do servidor (/Volumes/acervo2r/Boardview):
+// onde o nome do texto não existe na placa, o passo usa o nome da placa e a
+// observação guarda o nome original.
+const M1_02020 = `01 USBC0_CC1
+02 PPVBUS_USBC0
+03 PP3V3_UPC0_LDO
+04 PP1V5_UPC0_LDO_CORE
+05 PPDCIN_USBC_AON (no texto: PPDCIN_AONSW — na 820-02020 o nome é PPDCIN_USBC_AON)
+06 PPDCIN_AON_CHGR_R
+07 PPCHGR_VDDA
+08 PPCHGR_VDDP
+09 PPBUS_AON
+10 CHGR_EN_MVR (no texto: CHGR_MVR_EN)
+11 P3V8AON_PWR_EN
+12 PP5V_AON
+13 PP3V8_AON (no texto: PP3V8_AON_VDDMAIN)
+14 MPMU_XOUT,MPMU_XIN (32.768KHz) (ELE MANDA O MESMO CLOCK PARA U7700)
+15 PP5V_BSTLQ_SPMU
+16 PP5V_BSTLQ_MPMU
+17 PP1V8_AON_MPMU
+18 P3V3_S2_PWR_EN_R (no texto: P3V3_S2_PWR_EN)
+19 PP1V8_AWAKE
+20 PP2V5_AWAKE_NAND
+21 P5V_S2_PWR_EN_R (no texto: P5V_S2_PWR_EN)
+22 PP1V06_S2SW_DRAM
+23 PP0V88_S1
+24 PP0V764_S1_SRAM (no texto: PP0V7764_S1_SRAM)
+25 PPVDD_DISP_S1
+26 PPVDD_SOC_S1
+27 PPVDD_DCS_S1
+28 PP0V6_S1_VDDQL
+29 PP3V3_S2
+30 PP1V25_S2
+31 PP1V8_S2
+32 PP3V3_S2_UPC
+33 PP0V855_S2SW_CIO
+34 PP0V805_S1_VDD_FIXED
+35 PP1V2_S2_CIO
+36 PP1V25_AWAKE_NAND (não existe na 820-02020 — só na 820-02016)
+37 PP1V2_AWAKE_PLL
+38 PP0V88_AWAKESW_NAND (no texto: PP0V88_AWAKE_NAND)
+39 PP5V_S2
+40 PPVDD_CPU_SRAM_AWAKE
+41 PPVDD_ECPU_AWAKE
+42 PPVDD_PCPU_AWAKE
+43 PPVDD_GPU_AWAKE
+44 PPVOUT_LCDBKLT (no texto: PPVOUT_LCD_BACKLT)`;
+const M1_02016 = M1_02020
+  .replace(/^05 .*$/m, '05 PPDCIN_AONSW')
+  .replace(/^13 .*$/m, '13 PP3V8_AON_VDDMAIN')
+  .replace(/^36 .*$/m, '36 PP1V25_AWAKE_NAND')
+  .replace(/^38 .*$/m, '38 PP0V88_AWAKE_NAND');
+const CREDIT = 'Wellington — Welltech (sequência usada nos testes do 2R Tools)';
+const BUILTIN: Roteiro[] = [
+  { ...parseRoteiro('A2338 · MacBook Pro 13 M1 · 820-02020 — sequência de start\n' + M1_02020), id: 'm1-a2338', models: ['A2338'], builtin: true, by: 'Roger (2R Tools)', credit: CREDIT, created: 0 },
+  { ...parseRoteiro('A2337 · MacBook Air M1 · 820-02016 — sequência de start\n' + M1_02016), id: 'm1-a2337', models: ['A2337'], builtin: true, by: 'Roger (2R Tools)', credit: CREDIT, created: 0 },
+];
+
+const KEY = '2r-teleguiado';
+const ON_KEY = '2r-teleguiado-on';
+const HIDE_KEY = '2r-teleguiado-ocultos';
+let hidden: string[] = (() => { try { return JSON.parse(localStorage.getItem(HIDE_KEY) || '[]'); } catch { return []; } })();
+let own: Roteiro[] = (() => { try { return JSON.parse(localStorage.getItem(KEY) || '[]'); } catch { return []; } })();
+const EDIT_KEY = '2r-teleguiado-edicoes';     // passos editados dos roteiros de fábrica
+const edits: Record<string, Step[]> = (() => { try { return JSON.parse(localStorage.getItem(EDIT_KEY) || '{}'); } catch { return {}; } })();
+const CRED_KEY = '2r-teleguiado-creditos';
+const credits: Record<string, string> = (() => { try { return JSON.parse(localStorage.getItem(CRED_KEY) || '{}'); } catch { return {}; } })();
+let list: Roteiro[] = [...own, ...BUILTIN.filter(b => !hidden.includes(b.id))
+  .map(b => ({ ...b, ...(edits[b.id] ? { steps: edits[b.id] } : {}), ...(credits[b.id] != null ? { credit: credits[b.id] } : {}) }))];
+let active: Roteiro | null = null;
+let pos = 0;
+let on = false;
+let pointIdx = 0;              // qual ponto da net está indicado (Tab troca)
+let programming = false;      // montando a lista de pontos a medir (Roger, 11/10/2026)
+let rev = 0;
+const subs = new Set<() => void>();
+const emit = () => { rev++; subs.forEach(f => f()); };
+const save = () => {
+  own = list.filter(r => !r.builtin);
+  for (const r of list) if (r.builtin) edits[r.id] = r.steps;
+  try {
+    localStorage.setItem(KEY, JSON.stringify(own)); localStorage.setItem(HIDE_KEY, JSON.stringify(hidden));
+    localStorage.setItem(EDIT_KEY, JSON.stringify(edits)); localStorage.setItem(CRED_KEY, JSON.stringify(credits));
+  } catch { /* */ }
+};
+const norm = (s: string) => s.trim().toUpperCase().replace(/-/g, '_').replace(/\s+/g, '');
+
+/** Converte o texto colado num roteiro. */
+export function parseRoteiro(text: string): Roteiro {
+  const lines = text.split(/\r?\n/).map(l => l.trim()).filter(Boolean);
+  let title = '';
+  const steps: Step[] = [];
+  for (const line of lines) {
+    const m = /^(\d{1,3})[\s.)\-–:]+(.+)$/.exec(line);
+    if (!m) { if (!steps.length && !title) title = line; else if (steps.length) steps[steps.length - 1].note += (steps[steps.length - 1].note ? ' ' : '') + line; continue; }
+    let body = m[2];
+    const notes: string[] = [];
+    body = body.replace(/\(([^)]*)\)/g, (_s, g) => { notes.push(String(g).trim()); return ' '; });
+    const nets = body.split(/[,;/]+|\s+e\s+/i).map(s => s.trim()).filter(Boolean)
+      .map(s => s.split(/\s+/)[0]).filter(s => /[A-Z0-9_]{2,}/i.test(s));
+    steps.push({ n: parseInt(m[1], 10), nets, note: notes.join(' · '), raw: line });
+  }
+  const board = (/(820-\d{4,5}(?:-[A-Z0-9]+)?)/i.exec(title)?.[1] || '').toUpperCase();
+  return { id: `${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 6)}`, title: title || 'Roteiro', board, steps, created: Date.now(), kind: 'start' };
+}
+
+/** Acha as nets do passo na placa e os pontos bons para medir (capacitor primeiro). */
+export function resolve(board: BoardData, step: Step): Resolved {
+  const byNorm = new Map<string, string>();
+  for (const name of board.nets.keys()) byNorm.set(norm(name), name);
+  const nets: string[] = [], missing: string[] = [];
+  for (const want of step.nets) {
+    const k = norm(want);
+    let hit = byNorm.get(k);
+    if (!hit) {                                  // nome parecido: sem sufixo/prefixo
+      const cands = [...byNorm.keys()].filter(n => n.startsWith(k) || k.startsWith(n) || n.endsWith('_' + k));
+      if (cands.length === 1) hit = byNorm.get(cands[0]);
+    }
+    if (hit) nets.push(hit); else missing.push(want);
+  }
+  const points: (Point & { score: number })[] = [];
+  for (const net of nets) {
+    for (const { partIndex, pinIndex } of board.nets.get(net)?.pinIndices ?? []) {
+      const p = board.parts[partIndex];
+      if (!p || p.hidden) continue;
+      const nm = p.name.toUpperCase();
+      const kind: Point['kind'] = p.pins.length === 1 ? 'teste'
+        : p.pins.length <= 3 && /^C\d/.test(nm) ? 'capacitor'
+        : p.pins.length <= 3 && /^(R|RP)\d/.test(nm) ? 'resistor'
+        : p.pins.length <= 3 && /^(L|FB)\d/.test(nm) ? 'bobina' : 'outro';
+      const score = { capacitor: 0, teste: 1, resistor: 2, bobina: 3, outro: 9 }[kind];
+      const q = p.pins[pinIndex];
+      points.push({ partIndex, pinIndex, label: `${p.name}.${q.number || q.name}`, kind, score });
+    }
+  }
+  // ponto escolhido à mão vem primeiro (mesmo que seja de outra net — o técnico sabe)
+  if (step.point) {
+    const [pn, qn] = step.point.toUpperCase().split('.');
+    const pi = board.parts.findIndex(p => p.name.toUpperCase() === pn);
+    const qi = pi >= 0 ? board.parts[pi].pins.findIndex(q => (q.number || q.name).toUpperCase() === qn) : -1;
+    if (qi >= 0) {
+      const ex = points.find(p => p.partIndex === pi && p.pinIndex === qi);
+      if (ex) { ex.score = -1; ex.fixed = true; }
+      else points.push({ partIndex: pi, pinIndex: qi, label: step.point.toUpperCase(), kind: 'outro', fixed: true, score: -1 });
+    }
+  }
+  points.sort((a, b) => a.score - b.score || a.label.localeCompare(b.label, undefined, { numeric: true }));
+  return { step, nets, missing, points: points.map(({ score: _s, ...r }) => r) };
+}
+
+function current(): Resolved | null {
+  const b = boardStore.activeTab?.board;
+  if (!active || !b || !active.steps[pos]) return null;
+  return resolve(b, active.steps[pos]);
+}
+
+/** Zoom da Sequência de start (Roger, 11/10/2026): passando de um passo para o outro
+ *  o zoom NÃO muda — só centraliza o ponto. O último zoom fica guardado e volta ao
+ *  ligar a sequência de novo. */
+let applySavedZoom = false;
+function savedZoom(): number | undefined {
+  try { const v = parseFloat(localStorage.getItem('2r-seq-zoom') || ''); return v > 0 ? v : undefined; } catch { return undefined; }
+}
+
+/** Mostra o passo na placa: acende a net e leva a câmera ao ponto indicado. */
+function show() {
+  const r = current();
+  if (!r) { emit(); return; }
+  const tab = boardStore.activeTab;
+  const pt = r.points[pointIdx % Math.max(1, r.points.length)];
+  if (pt && tab?.board) {
+    const z = applySavedZoom ? savedZoom() : undefined;
+    applySavedZoom = false;
+    boardStore.focusPinKeepZoom(pt.partIndex, pt.pinIndex, z);
+  } else if (r.nets[0]) {
+    boardStore.highlightNet(r.nets[0]);
+  }
+  followSchematic(r);
+  emit();
+}
+
+/** Esquemático junto (Roger: «deixar linkado com o esquemático, cada ponto que pular,
+ *  alterar no esquemático também»): procura a net do passo no PDF da placa. */
+const PDF_KEY = '2r-seq-pdf';
+let pdfFollow = (() => { try { return localStorage.getItem(PDF_KEY) !== '0'; } catch { return true; } })();
+let pdfTimer: number | undefined;
+function followSchematic(r: Resolved) {
+  if (!pdfFollow || !r.nets[0]) return;
+  const pdfs = boardStore.activeTab?.pdfFileNames ?? [];
+  if (!pdfs.length) return;
+  window.clearTimeout(pdfTimer);
+  // depois do «seguir PDF» do próprio BoardRipper (que procura pelo componente), para a net valer
+  pdfTimer = window.setTimeout(() => {
+    try {
+      pdfStore.switchTo(pdfs[0]);
+      pdfStore.lookupEntity(pdfs[0], r.nets[0], r.nets.slice(1).map(text => ({ text, kind: 'net' as const })), 'lookup');
+    } catch { /* PDF ainda carregando */ }
+  }, 180);
+}
+
+export const guideStore = {
+  subscribe(f: () => void) { subs.add(f); return () => { subs.delete(f); }; },
+  get rev() { return rev; },
+  get list() { return list; },
+  get active() { return active; },
+  get pos() { return pos; },
+  get on() { return on; },
+  get pointIdx() { return pointIdx; },
+  get pdfFollow() { return pdfFollow; },
+  setPdfFollow(v: boolean) { pdfFollow = v; try { localStorage.setItem(PDF_KEY, v ? '1' : '0'); } catch { /* */ } const r = current(); if (v && r && on) followSchematic(r); emit(); },
+  current,
+  add(text: string): Roteiro | null {
+    const r = parseRoteiro(text);
+    if (!r.steps.length) return null;
+    list = [r, ...list.filter(x => !(x.title === r.title && x.board === r.board))];
+    save(); push(r); emit();
+    return r;
+  },
+  remove(id: string) { const old = list.find(x => x.id === id); if (old && !old.builtin) push(old, true); if (BUILTIN.some(b => b.id === id)) hidden = [...hidden, id]; list = list.filter(x => x.id !== id); if (active?.id === id) { active = null; on = false; } save(); emit(); },
+  /** Roteiros que combinam com a placa aberta (pelo 820-xxxxx no nome do arquivo). */
+  forOpenBoard(): Roteiro[] {
+    const f = (boardStore.activeTab?.fileName || '').toUpperCase();
+    return list.filter(r => matchesBoard(r, f));
+  },
+  open(id: string) { active = list.find(x => x.id === id) ?? null; pos = 0; pointIdx = 0; emit(); },
+  start() { if (!active) return; on = true; applySavedZoom = true; try { localStorage.setItem(ON_KEY, '1'); } catch { /* */ } show(); },
+  stop() { on = false; try { localStorage.setItem(ON_KEY, '0'); } catch { /* */ } emit(); },
+  go(i: number) { if (!active) return; pos = Math.max(0, Math.min(active.steps.length - 1, i)); pointIdx = 0; show(); },
+  next() { guideStore.go(pos + 1); },
+  prev() { guideStore.go(pos - 1); },
+  /** Outro ponto da mesma net (Tab). */
+  nextPoint(d = 1) { const r = current(); if (!r?.points.length) return; pointIdx = (pointIdx + d + r.points.length) % r.points.length; show(); },
+  usePoint(i: number) { pointIdx = i; show(); },
+
+  // ── edição dos passos (Roger: «add a opção de editar o ponto teleguiado») ──
+  /** Muda nets / observação / ponto do passo i do roteiro aberto. */
+  editStep(i: number, patch: Partial<Step>) {
+    if (!active || !active.steps[i]) return;
+    const steps = active.steps.map((st, k) => (k === i ? { ...st, ...patch } : st));
+    replaceActive(steps);
+    const onlyValues = Object.keys(patch).every(k => ['v', 'd', 'r', 'valBy', 'valAt', 'note'].includes(k));
+    if (i === pos && !onlyValues) { pointIdx = 0; if (on) show(); }
+  },
+  /** Fixa o pino selecionado na placa como o ponto do passo atual. */
+  pinSelectedAsPoint(i = pos): string {
+    const tab = boardStore.activeTab;
+    const sel = tab?.selection;
+    const part = tab?.board && sel?.partIndex != null ? tab.board.parts[sel.partIndex] : null;
+    const pin = part && sel?.pinIndex != null && sel.pinIndex >= 0 ? part.pins[sel.pinIndex] : null;
+    if (!part || !pin) return '';
+    const label = `${part.name}.${pin.number || pin.name}`;
+    guideStore.editStep(i, { point: label });
+    return label;
+  },
+  clearPoint(i = pos) { guideStore.editStep(i, { point: undefined }); },
+  insertStep(after: number) {
+    if (!active) return;
+    const steps = [...active.steps];
+    steps.splice(after + 1, 0, { n: 0, nets: [], note: '', raw: '' });
+    replaceActive(renumber(steps));
+    pos = after + 1; emit();
+  },
+  deleteStep(i: number) {
+    if (!active || active.steps.length <= 1) return;
+    const steps = active.steps.filter((_s, k) => k !== i);
+    replaceActive(renumber(steps));
+    pos = Math.min(pos, steps.length - 1); if (on) show(); else emit();
+  },
+  moveStep(i: number, d: -1 | 1) {
+    if (!active) return;
+    const j = i + d;
+    if (j < 0 || j >= active.steps.length) return;
+    const steps = [...active.steps];
+    [steps[i], steps[j]] = [steps[j], steps[i]];
+    replaceActive(renumber(steps));
+    if (pos === i) pos = j; emit();
+  },
+  /** Sequência nova do zero para a placa aberta (Roger: «criar sua própria sequência de análise»). */
+  createBlank(title: string, kind: 'start' | 'analise', credit: string): Roteiro | null {
+    const f = boardStore.activeTab?.fileName || '';
+    const num = /(820-\d{4,5})/i.exec(f)?.[1]?.toUpperCase() || '';
+    const r: Roteiro = { id: `${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 6)}`,
+      title: title.trim() || `${num || f} — ${kind === 'start' ? 'sequência de start' : 'sequência de análise'}`,
+      board: num, steps: [], created: Date.now(), kind, credit: credit.trim(), by: credit.trim() };
+    list = [r, ...list]; active = r; pos = 0; pointIdx = 0;
+    save(); push(r); emit();
+    return r;
+  },
+  /** Acrescenta um passo com a net do pino selecionado (e fixa esse pino como ponto). */
+  addSelectedPin(): string {
+    if (!active) return '';
+    const tab = boardStore.activeTab, sel = tab?.selection;
+    const part = tab?.board && sel?.partIndex != null ? tab.board.parts[sel.partIndex] : null;
+    const pin = part && sel?.pinIndex != null && sel.pinIndex >= 0 ? part.pins[sel.pinIndex] : null;
+    if (!part || !pin) return '';
+    const label = `${part.name}.${pin.number || pin.name}`;
+    const steps = [...active.steps];
+    const at = active.steps.length ? pos + 1 : 0;
+    steps.splice(at, 0, { n: 0, nets: pin.net ? [pin.net] : [], note: '', raw: '', point: label });
+    replaceActive(renumber(steps));
+    pos = at; emit();
+    return label;
+  },
+  /** Leitura do instrumento com a sequência ligada: preenche a coluna do modo no passo atual. */
+  recordValue(mode: 'tensao' | 'diodo' | 'resistencia', value: number, unit: string, by = ''): boolean {
+    if (!on || !active || !active.steps[pos]) return false;
+    const txt = mode === 'resistencia' ? fmtOhm(value) : value.toFixed(3);
+    const key = mode === 'tensao' ? 'v' : mode === 'diodo' ? 'd' : 'r';
+    void unit;
+    guideStore.editStep(pos, { [key]: txt, valBy: by, valAt: Date.now() } as Partial<Step>);
+    return true;
+  },
+  // ── programar os pontos a medir (Roger, 11/10/2026): clicar/buscar na placa e no PDF,
+  //    ou pegar o CI inteiro; depois «Finalizar e medir». ──
+  get programming() { return programming; },
+  setProgramming(v: boolean) { programming = v; emit(); },
+  /** Começa uma lista nova (análise) para programar os pontos; entra no modo programar. */
+  startProgramming(ciName?: string): void {
+    const f = boardStore.activeTab?.fileName || '';
+    const num = /(820-\d{4,5})/i.exec(f)?.[1]?.toUpperCase() || '';
+    const title = (ciName ? `${ciName} — pontos` : `${num || 'Placa'} — pontos a medir`);
+    guideStore.createBlank(title, 'analise', '');
+    programming = true; on = false; emit();
+  },
+  /** Adiciona a net pelo nome (busca). Põe o melhor ponto (capacitor primeiro) como ponto. */
+  addNetByName(name: string): string {
+    const b = boardStore.activeTab?.board;
+    if (!active || !b) return '';
+    const want = norm(name);
+    let net = '';
+    for (const nm of b.nets.keys()) { if (norm(nm) === want) { net = nm; break; } }
+    if (!net) for (const nm of b.nets.keys()) { if (norm(nm).includes(want)) { net = nm; break; } }
+    if (!net) return '';
+    const steps = [...active.steps];
+    if (steps.some(st => st.nets.includes(net) && !st.point)) { /* já tem */ }
+    const tmp: Step = { n: 0, nets: [net], note: '', raw: '' };
+    const r = resolve(b, tmp);
+    const pt = r.points[0]?.label;
+    steps.push({ n: 0, nets: [net], note: '', raw: '', ...(pt ? { point: pt } : {}) });
+    replaceActive(renumber(steps));
+    pos = steps.length - 1; if (pt) show(); else emit();
+    return net;
+  },
+  /** Mapeia todos os pontos do CI selecionado (ou pelo índice) e add como passos. */
+  addComponentPins(partIndex?: number, skipGnd = false): number {
+    const b = boardStore.activeTab?.board;
+    const sel = boardStore.activeTab?.selection;
+    const pi = partIndex != null ? partIndex : sel?.partIndex;
+    const part = b && pi != null ? b.parts[pi] : null;
+    if (!b || !part) return 0;
+    if (!active) guideStore.startProgramming(part.name);
+    const steps = active ? [...active.steps] : [];
+    let added = 0;
+    part.pins.forEach((pin) => {
+      const label = `${part.name}.${pin.number || pin.name}`;
+      if (steps.some(st => st.point === label)) return;
+      const net = (pin.net || '').trim();
+      if (skipGnd && /^(GND|AGND|VSS|PGND)/i.test(net)) return;
+      steps.push({ n: 0, nets: net ? [net] : [], note: '', raw: '', point: label });
+      added++;
+    });
+    if (added) replaceActive(renumber(steps));
+    return added;
+  },
+  /** Finaliza a programação e começa a medir (liga a sequência). */
+  finishProgramming(): void {
+    programming = false;
+    if (active && active.steps.length) { pos = 0; pointIdx = 0; guideStore.start(); }
+    else emit();
+  },
+
+  /** Renomeia o teste do passo (não muda a net). */
+  renameStep(i: number, name: string) { guideStore.editStep(i, { name: name.trim() || undefined } as Partial<Step>); },
+  /** Valor certo (ideal) do passo, por modo. */
+  setIdeal(i: number, k: 'iv' | 'id' | 'ir', val: string) { guideStore.editStep(i, { [k]: val.trim() || undefined } as Partial<Step>); },
+  /** Marca/desmarca a estrela («valor certo depois do reparo»). */
+  toggleStar(i: number) { const st = active?.steps[i]; if (st) guideStore.editStep(i, { star: !st.star } as Partial<Step>); },
+  /** Copia o medido (v/d/r) para o valor certo (iv/id/ir) e marca a estrela — «valores certos depois do reparo». */
+  markCorrect(onlyIndex?: number) {
+    if (!active) return;
+    const steps = active.steps.map((st, k) => {
+      if (onlyIndex != null && k !== onlyIndex) return st;
+      const has = st.v || st.d || st.r;
+      if (!has) return st;
+      return { ...st, iv: st.v ?? st.iv, id: st.d ?? st.id, ir: st.r ?? st.ir, star: true };
+    });
+    replaceActive(steps);
+  },
+
+  setCredit(credit: string) {
+    if (!active) return;
+    const upd = { ...active, credit: credit.trim() };
+    list = list.map(r => (r.id === upd.id ? upd : r)); active = upd;
+    if (upd.builtin) credits[upd.id] = upd.credit || '';
+    save(); push(upd); emit();
+  },
+  /** Volta o roteiro de fábrica ao original. */
+  resetBuiltin() {
+    if (!active?.builtin) return;
+    const b = BUILTIN.find(x => x.id === active!.id);
+    if (!b) return;
+    delete edits[b.id];
+    replaceActive(b.steps.map(s => ({ ...s })));
+  },
+};
+
+// ── junto do boardview (core/medicoes.py: <arquivo>.2r/sequencias.json) ──
+interface SeqApi { seqList?(b: string): Promise<{ rows: Roteiro[]; where?: string }>; seqSave?(b: string, r: unknown): Promise<{ ok: boolean }> }
+const api = () => (window as unknown as { __2rMeterApi?: SeqApi }).__2rMeterApi ?? null;
+let seqWhere = '';
+export const seqWhereNow = () => seqWhere;
+function push(r: Roteiro, del = false) {
+  const f = boardStore.activeTab?.fileName;
+  const a = api();
+  if (!f || !a?.seqSave) return;
+  void a.seqSave(f, { ...r, upd: Date.now(), ...(del ? { del: true } : {}) }).catch(() => {});
+}
+let lastBoard = '';
+async function pullSeq() {
+  const f = boardStore.activeTab?.fileName || '';
+  const a = api();
+  if (!f || f === lastBoard || !a?.seqList) return;
+  lastBoard = f;
+  try {
+    const r = await a.seqList(f);
+    seqWhere = r.where || '';
+    for (const rot of r.rows || []) {
+      const b = BUILTIN.find(x => x.id === rot.id);
+      const merged: Roteiro = b ? { ...b, steps: rot.steps, credit: rot.credit ?? b.credit } : { ...rot, builtin: false };
+      list = [merged, ...list.filter(x => x.id !== rot.id)];
+      if (active?.id === rot.id) active = merged;
+    }
+    emit();
+  } catch { /* */ }
+}
+
+/** O roteiro é desta placa? (820-xxxxx no nome do arquivo, sem a revisão, ou o A-number). */
+export function matchesBoard(r: Roteiro, fileName: string): boolean {
+  const f = (fileName || '').toUpperCase();
+  const num = /^(820-\d{4,5})/.exec(r.board || '')?.[1];
+  return (!!num && f.includes(num)) || (r.models ?? []).some(m => f.includes(m));
+}
+
+function fmtOhm(v: number): string {
+  const a = Math.abs(v);
+  return a >= 1e6 ? (v / 1e6).toFixed(2) + 'M' : a >= 1e3 ? (v / 1e3).toFixed(2) + 'k' : v.toFixed(1);
+}
+
+function renumber(steps: Step[]): Step[] { return steps.map((s, k) => ({ ...s, n: k + 1 })); }
+function replaceActive(steps: Step[]) {
+  if (!active) return;
+  const upd = { ...active, steps };
+  list = list.map(r => (r.id === upd.id ? upd : r));
+  active = upd;
+  save(); push(upd); emit();
+}
+
+function onKey(e: KeyboardEvent) {
+  if (!on || !active) return;
+  const t = e.target as HTMLElement | null;
+  if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.tagName === 'SELECT' || t.isContentEditable)) return;
+  if (e.metaKey || e.ctrlKey || e.altKey) return;
+  const k = e.key;
+  if (k === 'ArrowRight' || k === 'ArrowDown') guideStore.next();
+  else if (k === 'ArrowLeft' || k === 'ArrowUp') guideStore.prev();
+  else if (k === 'Tab') guideStore.nextPoint(e.shiftKey ? -1 : 1);
+  else if (k === 'Escape') guideStore.stop();
+  else return;
+  e.preventDefault(); e.stopImmediatePropagation();
+}
+
+export function installGuide(): void {
+  if (!IS_2R || !beta('teleguiado')) return;
+  window.addEventListener('keydown', onKey, true);
+  boardStore.subscribe(() => { void pullSeq(); });
+}
diff --git a/src/frontend/src/r2/loose-match.ts b/src/frontend/src/r2/loose-match.ts
new file mode 100644
index 00000000..3193a85a
--- /dev/null
+++ b/src/frontend/src/r2/loose-match.ts
@@ -0,0 +1,33 @@
+/**
+ * 2R Tools (Roger, 11/10/2026): «na busca, permitir busca quebrada… a linha é
+ * pp_1v25_awake_nand… posso buscar por nand, por pp1v25, por awake». Também no PDF.
+ * - ignora _ - . / espaço e maiúsculas: «pp_1v25» acha PP1V25_AWAKE_NAND;
+ * - vários pedaços separados por espaço, em qualquer ordem: «nand 1v25» também acha.
+ */
+const norm = (s: string) => s.toLowerCase().replace(/[^a-z0-9+]/g, '');
+
+export function looseTokens(q: string): string[] {
+  return q.trim().split(/\s+/).map(norm).filter(Boolean);
+}
+
+/** O nome bate com a busca (cada pedaço aparece em algum lugar do nome). */
+export function looseMatch(name: string, q: string | string[]): boolean {
+  const toks = Array.isArray(q) ? q : looseTokens(q);
+  if (!toks.length) return false;
+  const n = norm(name);
+  return toks.every(t => n.includes(t));
+}
+
+/** PDF: acha `q` no texto ignorando _ - . e espaços. Devolve [início, fim) no texto original. */
+export function looseFind(text: string, q: string, from = 0): [number, number] | null {
+  const nq = norm(q);
+  if (!nq) return null;
+  let ns = ''; const map: number[] = [];
+  for (let i = from; i < text.length; i++) {
+    const c = text[i].toLowerCase();
+    if (/[a-z0-9+]/.test(c)) { ns += c; map.push(i); }
+  }
+  const p = ns.indexOf(nq);
+  if (p < 0) return null;
+  return [map[p], map[p + nq.length - 1] + 1];
+}
diff --git a/src/frontend/src/r2/meter-store.ts b/src/frontend/src/r2/meter-store.ts
new file mode 100644
index 00000000..dd6563c1
--- /dev/null
+++ b/src/frontend/src/r2/meter-store.ts
@@ -0,0 +1,383 @@
+/**
+ * 2R Tools: medições do multímetro (Rigol DM858E / i2C C09) ligadas ao pino
+ * selecionado na placa (Roger, 10/10/2026). A leitura estável entra na lista
+ * com o pino, a net, o valor esperado (OpenBoardData), o resultado, quem mediu
+ * e a hora. Tolerância (Roger): diodo ±20%; tensão e resistência quase nenhuma (±2%).
+ *
+ * Brainstorm do Roger (10/10/2026, 21:03): «gravar automaticamente… com um
+ * aviso sonoro quando está dentro da margem (agradável), ou se estiver muito
+ * fora, um aviso mais tenso ou grave… configurar o tempo de captura automática
+ * ou manual, com a opção de configurar quais teclas… editar e capturar
+ * novamente, deletar… sempre ter os dados de quem capturou com a data e o horário».
+ */
+import { boardStore } from '../store/board-store';
+import { obdBoardNumberFor, obdNetLookup } from '../store/obd-store';
+import { IS_2R, beta } from './env';
+import { seqPrefs, stepPin } from './probe-seq';
+import { guideStore } from './guide-store';
+import { playOk, playWarn, playBad, playTick, playSaved, playNotSaved } from './sounds';
+
+export type Mode = 'diodo' | 'tensao' | 'resistencia';
+export interface Medicao {
+  t: number; board: string; part: string; pin: string; net: string;
+  mode: Mode; value: number; unit: string; expected: string; status: 'ok' | 'fora' | 'sem'; source: string;
+  /** Medido no ponto mais próximo da mesma net (ex.: «C12.1»), quando o pad estava inacessível. */
+  via?: string;
+  /** Quem mediu (nome do técnico pelo PIN, senão a conta). */
+  by?: string;
+  /** Valor corrigido à mão (o original fica em `orig`). */
+  edited?: boolean; orig?: number;
+  /** Identidade da medição entre os computadores da loja e quando mudou por último. */
+  id?: string; upd?: number; del?: boolean;
+}
+export interface MeterStatus { state: string; text: string; idn?: string; kind?: string }
+
+/** Como a leitura entra na lista. */
+export interface CapturePrefs {
+  auto: boolean;        // true: grava sozinho quando a leitura firma
+  holdMs: number;       // quanto tempo a leitura precisa ficar parada
+  key: string;          // tecla da captura manual (KeyboardEvent.code)
+  /** Som da leitura: dentro da margem / um pouco fora / muito fora (toca quando a leitura firma). */
+  sound: boolean;
+  /** Som da gravação: gravou / não gravou. */
+  soundSave: boolean;
+}
+const CAP_KEY = '2r-medicoes-captura';
+const DEFAULT_CAP: CapturePrefs = { auto: true, holdMs: 1000, key: 'Enter', sound: true, soundSave: true };
+
+const KEY = '2r-medicoes';
+const TOL_KEY = '2r-medicoes-tol';
+export const DEFAULT_TOL: Record<Mode, number> = { diodo: 20, tensao: 2, resistencia: 2 };
+
+const PEND_KEY = '2r-medicoes-pend';
+const newId = () => `${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 8)}`;
+let list: Medicao[] = (() => { try { return JSON.parse(localStorage.getItem(KEY) || '[]'); } catch { return []; } })();
+/** Medições antigas (antes da pasta da loja) ganham identidade e vão para o envio. */
+let pend: Medicao[] = (() => { try { return JSON.parse(localStorage.getItem(PEND_KEY) || '[]'); } catch { return []; } })();
+list = list.map(m => { if (m.id) return m; const n = { ...m, id: newId(), upd: m.t }; pend.push(n); return n; });
+/** «loja» = histórico na pasta da loja; «local» = só neste computador; '' = ainda não sabe. */
+let where = '';
+let live: { value: number | null; unit: string; text: string } | null = null;
+let status: MeterStatus = { state: 'off', text: 'Desligado' };
+/** Ponto alternativo escolhido para o pino atual («medir por aqui»). */
+let via: { pin: string; at: string } | null = null;
+/** «Medir de novo»: a próxima leitura desse pino substitui a linha antiga. */
+let redo: { t: number; key: string } | null = null;
+let who = '';
+let rev = 0;
+const subs = new Set<() => void>();
+const emit = () => { rev++; subs.forEach(f => f()); };
+const save = () => {
+  try { localStorage.setItem(KEY, JSON.stringify(list.slice(0, 2000))); localStorage.setItem(PEND_KEY, JSON.stringify(pend.slice(-3000))); } catch { /* */ }
+};
+
+// ── pasta da loja: os computadores veem o mesmo histórico (core/medicoes.py) ──
+function push(recs: Medicao[]) {
+  if (!recs.length) return;
+  const ids = new Set(recs.map(r => r.id));
+  pend = [...pend.filter(p => !ids.has(p.id)), ...recs];
+  save();
+  void flush();
+}
+let flushing = false;
+async function flush() {
+  const api = meterApi();
+  if (!api?.histSave || flushing || !pend.length) return;
+  flushing = true;
+  const batch = pend.slice(0, 300);
+  try {
+    const r = await api.histSave(batch);
+    if (r?.ok) {
+      const done = new Set(batch.map(b => `${b.id}|${b.upd}`));
+      pend = pend.filter(p => !done.has(`${p.id}|${p.upd}`));
+      if (r.where) where = r.where;
+      save(); emit();
+    }
+  } catch { /* sem conexão: tenta de novo depois */ }
+  flushing = false;
+  if (pend.length && batch.length === 300) void flush();
+}
+let pulling = false;
+/** Traz da pasta da loja as medições da placa aberta (de todos os computadores). */
+async function pull(board: string) {
+  const api = meterApi();
+  if (!api?.histList || !board || pulling) return;
+  pulling = true;
+  try {
+    const r = await api.histList(board);
+    if (r && Array.isArray(r.rows)) {
+      if (r.where) where = r.where;
+      const mine = new Map(pend.filter(p => p.board === board).map(p => [p.id, p]));
+      const merged = new Map<string, Medicao>();
+      for (const m of r.rows as Medicao[]) if (m.id) merged.set(m.id, m);
+      for (const [id, p] of mine) {                     // o que ainda não subiu manda
+        const cur = merged.get(id!);
+        if (!cur || (p.upd ?? 0) >= (cur.upd ?? 0)) merged.set(id!, p);
+      }
+      const rows = [...merged.values()].filter(m => !m.del).sort((a, b) => b.t - a.t);
+      const before = JSON.stringify(list.filter(m => m.board === board).map(m => m.id + ':' + m.upd));
+      const after = JSON.stringify(rows.map(m => m.id + ':' + m.upd));
+      if (before !== after) {
+        list = [...rows, ...list.filter(m => m.board !== board)].sort((a, b) => b.t - a.t);
+        save(); emit();
+      } else if (r.where) emit();
+    }
+  } catch { /* */ }
+  pulling = false;
+}
+function syncTick() {
+  // checkup: com a tela da placa escondida (outra página do SDS) não vai à pasta da loja
+  if (document.hidden && !pend.length) return;
+  void flush();
+  const b = boardStore.activeTab?.fileName;
+  if (b) void pull(b);
+}
+
+function loadCap(): CapturePrefs {
+  try { return { ...DEFAULT_CAP, ...JSON.parse(localStorage.getItem(CAP_KEY) || '{}') }; } catch { return { ...DEFAULT_CAP }; }
+}
+let cap = loadCap();
+
+export const meterStore = {
+  subscribe(f: () => void) { subs.add(f); return () => { subs.delete(f); }; },
+  /** Muda a cada alteração (para o useSyncExternalStore). */
+  get rev() { return rev; },
+  get list() { return list; },
+  get live() { return live; },
+  get status() { return status; },
+  get via() { return via; },
+  get redo() { return redo; },
+  get who() { return who; },
+  get where() { return where; },
+  get pending() { return pend.length; },
+  /** Medições da placa aberta (ou todas, sem placa aberta). */
+  get shown() { const b = boardStore.activeTab?.fileName; return b ? list.filter(m => m.board === b) : list; },
+  setVia(v: { pin: string; at: string } | null) { via = v; emit(); },
+  /** Apaga as medições da placa aberta (em todos os computadores da loja). */
+  clear() {
+    const now = Date.now();
+    const gone = meterStore.shown.map(m => ({ ...m, del: true, upd: now }));
+    const ids = new Set(gone.map(m => m.id));
+    list = list.filter(m => !ids.has(m.id)); redo = null;
+    push(gone); emit();
+  },
+  remove(t: number) {
+    const m = list.find(x => x.t === t);
+    list = list.filter(x => x.t !== t); if (redo?.t === t) redo = null;
+    if (m) push([{ ...m, del: true, upd: Date.now() }]);
+    save(); emit();
+  },
+  /** Corrige o valor à mão (fica marcado como editado). */
+  edit(t: number, value: number) {
+    let changed: Medicao | null = null;
+    list = list.map(m => m.t !== t ? m : (changed = judge({ ...m, value, edited: true, orig: m.orig ?? m.value, upd: Date.now() })));
+    if (changed) push([changed]);
+    save(); emit();
+  },
+  /** Medir de novo: seleciona o pino e a próxima leitura dele substitui esta linha. */
+  remeasure(t: number) {
+    const m = list.find(x => x.t === t);
+    const tab = boardStore.activeTab;
+    if (!m) return;
+    redo = { t, key: `${m.board}|${m.part}|${m.pin}` };
+    if (tab?.board && tab.fileName === m.board) {
+      const pi = tab.board.parts.findIndex(p => p.name === m.part);
+      const qi = pi >= 0 ? tab.board.parts[pi].pins.findIndex(p => (p.number || p.name) === m.pin) : -1;
+      if (pi >= 0 && qi >= 0) boardStore.selectPin(pi, qi);
+    }
+    emit();
+  },
+  cancelRedo() { redo = null; emit(); },
+  tolerance(): Record<Mode, number> {
+    try { return { ...DEFAULT_TOL, ...JSON.parse(localStorage.getItem(TOL_KEY) || '{}') }; } catch { return { ...DEFAULT_TOL }; }
+  },
+  setTolerance(m: Mode, v: number) {
+    const t = meterStore.tolerance(); t[m] = v;
+    try { localStorage.setItem(TOL_KEY, JSON.stringify(t)); } catch { /* */ }
+    emit();
+  },
+  get capture(): CapturePrefs { return cap; },
+  setCapture(p: Partial<CapturePrefs>) {
+    cap = { ...cap, ...p };
+    try { localStorage.setItem(CAP_KEY, JSON.stringify(cap)); } catch { /* */ }
+    emit();
+  },
+  /** Captura manual (botão ou tecla): grava a leitura que está na tela agora. */
+  captureNow() {
+    if (live?.value == null) { if (cap.soundSave) playNotSaved(); boardStore.addToast('Sem leitura agora (ponta aberta).', 'info'); return; }
+    capture({ value: live.value, unit: live.unit, source: sourceName() });
+  },
+  testSound(kind: 'ok' | 'warn' | 'bad' | 'saved' | 'notsaved') {
+    ({ ok: playOk, warn: playWarn, bad: playBad, saved: playSaved, notsaved: playNotSaved })[kind]();
+  },
+};
+
+export function modeOf(unit: string): Mode {
+  const u = (unit || '').toUpperCase();
+  if (u.includes('DIOD')) return 'diodo';
+  if (u.includes('OHM') || u.includes('Ω') || u.includes('RES')) return 'resistencia';
+  if (u.includes('V')) return 'tensao';
+  return 'diodo';
+}
+
+function num(s: string | null | undefined): number | null {
+  const m = /[-+]?\d+(?:[.,]\d+)?/.exec(s || '');
+  if (!m) return null;
+  let v = parseFloat(m[0].replace(',', '.'));
+  const rest = (s || '').slice(m.index + m[0].length).trim().toLowerCase();
+  if (rest.startsWith('k')) v *= 1e3; else if (rest.startsWith('m') && !rest.startsWith('mv')) v *= 1e6;
+  if (rest.startsWith('mv')) v /= 1000;
+  return v;
+}
+
+/** Quanto fora da margem: 0 = dentro; 1 = até 2× a margem; 2 = muito fora. */
+let lastSeverity = 0;
+function judge(m: Medicao): Medicao {
+  const exp = num(m.expected);
+  lastSeverity = 0;
+  if (exp === null) return { ...m, status: 'sem' };
+  const tol = meterStore.tolerance()[m.mode] / 100;
+  const lim = Math.max(Math.abs(exp) * tol, m.mode === 'diodo' ? 0.01 : 0.005);
+  const off = Math.abs(m.value - exp);
+  if (off <= lim) return { ...m, status: 'ok' };
+  lastSeverity = off <= lim * 2 ? 1 : 2;
+  return { ...m, status: 'fora' };
+}
+
+function sourceName(): string {
+  if (status.idn) return status.idn;
+  return status.kind === 'i2c' ? 'i2C C09' : status.kind === 'rigol' ? 'Rigol DM858E' : 'multímetro';
+}
+
+/** Pino selecionado e o valor esperado dele para a leitura (sem gravar). */
+function current(unit: string) {
+  const tab = boardStore.activeTab;
+  const sel = tab?.selection;
+  const part = tab?.board && sel?.partIndex != null ? tab.board.parts[sel.partIndex] : null;
+  const pin = part && sel?.pinIndex != null && sel.pinIndex >= 0 ? part.pins[sel.pinIndex] : null;
+  if (!tab || !part || !pin) return null;
+  const mode = modeOf(unit);
+  const obd = obdNetLookup(obdBoardNumberFor(tab) ?? undefined, pin.net)[0];
+  const expStr = (mode === 'diodo' ? obd?.diode : mode === 'tensao' ? obd?.voltage : obd?.resistance) ?? '';
+  return { tab, part, pin, mode, expStr };
+}
+
+/** Som da leitura: veredito da margem para o pino selecionado. */
+function verdictSound(value: number, unit: string) {
+  const c = current(unit);
+  if (!c) return;
+  const m = judge({ t: 0, board: '', part: '', pin: '', net: '', mode: c.mode, value, unit, expected: c.expStr, status: 'sem', source: '' });
+  (m.status === 'ok' ? playOk : m.status === 'fora' ? (lastSeverity >= 2 ? playBad : playWarn) : playTick)();
+}
+
+function capture(d: { value: number; unit: string; source: string }) {
+  const tab = boardStore.activeTab;
+  const sel = tab?.selection;
+  const part = tab?.board && sel?.partIndex != null ? tab.board.parts[sel.partIndex] : null;
+  const pin = part && sel?.pinIndex != null && sel.pinIndex >= 0 ? part.pins[sel.pinIndex] : null;
+  if (!tab || !part || !pin) {
+    if (cap.soundSave) playNotSaved();
+    boardStore.addToast('Leitura ' + d.value.toFixed(3) + ' recebida — selecione o pino na placa para guardar.', 'info');
+    return;
+  }
+  const mode = modeOf(d.unit);
+  const obd = obdNetLookup(obdBoardNumberFor(tab) ?? undefined, pin.net)[0];
+  const expStr = (mode === 'diodo' ? obd?.diode : mode === 'tensao' ? obd?.voltage : obd?.resistance) ?? '';
+  let m: Medicao = judge({ t: Date.now(), board: tab.fileName, part: part.name, pin: pin.number || pin.name, net: pin.net || '',
+    mode, value: d.value, unit: d.unit, expected: expStr, status: 'sem', source: d.source, ...(who ? { by: who } : {}) });
+  const here = `${part.name}.${m.pin}`;
+  if (via && via.pin === here) m = { ...m, via: via.at };
+  via = null;
+  // «medir de novo»: substitui a linha antiga do mesmo pino
+  const k = `${m.board}|${m.part}|${m.pin}`;
+  if (redo && redo.key === k) {
+    const old = list.find(x => x.t === redo!.t);
+    list = list.filter(x => x.t !== redo!.t);
+    if (old) push([{ ...old, del: true, upd: Date.now() }]);
+  }
+  m = { ...m, id: newId(), upd: m.t };
+  redo = null;
+  list = [m, ...list]; push([m]); emit();
+  // 1º padrão (leitura) se ainda não tocou neste toque; 2º padrão (gravou) logo depois
+  let delay = 0;
+  if (cap.sound && !announced) { verdictSound(d.value, d.unit); delay = 420; }
+  announced = true;
+  if (cap.soundSave) window.setTimeout(playSaved, delay);
+  boardStore.addToast(`${here}${m.via ? ` (medido em ${m.via})` : ''} (${m.net || 'sem net'}): ${d.value.toFixed(3)}`
+    + (m.status === 'ok' ? ' — OK' : m.status === 'fora' ? ` — fora do esperado (${expStr})` : ''), m.status === 'fora' ? 'error' : 'info');
+  // Sequência de start ligada: a leitura também vai para a coluna do passo atual
+  if (guideStore.on && guideStore.recordValue(mode, d.value, d.unit, who)) return;
+  if (seqPrefs.auto) window.setTimeout(() => stepPin(1), 250);   // próximo pino da sequência
+}
+
+// ── captura automática: leitura parada pelo tempo escolhido, uma por toque ──
+let since = 0, ref: number | null = null, armed = true, lastCaptured: number | null = null;
+/** O som da leitura já tocou neste toque da ponta. */
+let announced = false;
+function onLive(d: { value: number | null; unit: string; text: string }) {
+  live = d; emit();
+  const v = d.value;
+  const now = Date.now();
+  if (v == null) { armed = true; ref = null; announced = false; return; }          // ponta aberta: pronto para o próximo ponto
+  // ponta tirada em tensão/resistência (lê ~0) ou mudou muito: libera de novo
+  if (!armed && lastCaptured !== null) {
+    const moved = Math.abs(v - lastCaptured) > Math.max(0.01, Math.abs(lastCaptured) * 0.1);
+    if (moved) { armed = true; announced = false; }
+  }
+  const band = (r: number) => Math.max(0.003, Math.abs(r) * 0.01);
+  if (ref === null || Math.abs(v - ref) > band(ref)) { ref = v; since = now; announced = false; return; }
+  // som da leitura assim que firma (antes de gravar) — também ajuda na captura manual
+  if (!announced && now - since >= Math.min(350, cap.holdMs / 2)) {
+    announced = true;
+    if (cap.sound) verdictSound(v, d.unit);
+  }
+  if (!cap.auto || !armed) return;
+  if (now - since >= cap.holdMs) {
+    armed = false; lastCaptured = v; ref = null;
+    capture({ value: v, unit: d.unit, source: sourceName() });
+  }
+}
+
+function onKey(e: KeyboardEvent) {
+  if (cap.auto || status.state !== 'on') return;
+  const t = e.target as HTMLElement | null;
+  if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.tagName === 'SELECT' || t.isContentEditable)) return;
+  if (e.code !== cap.key && e.key !== cap.key) return;
+  e.preventDefault(); e.stopPropagation();
+  meterStore.captureNow();
+}
+
+export function installMeter(): void {
+  if (!IS_2R || !beta('medicoes')) return;
+  const w = window as unknown as Record<string, unknown>;
+  // a leitura estável agora é decidida aqui (tempo ajustável); a do app fica só de reserva
+  w.__2rMeterCapture = () => { /* captura feita por onLive() */ };
+  w.__2rMeterLive = (d: { value: number | null; unit: string; text: string }) => onLive(d);
+  w.__2rMeterStatus = (d: MeterStatus) => {
+    status = d; emit();
+    if (d.state === 'on') meterApi()?.who?.().then(r => { who = r?.name || ''; emit(); }).catch(() => {});
+  };
+  window.addEventListener('keydown', onKey, true);
+  // histórico na pasta da loja: envia o que falta e traz o dos outros computadores
+  window.setTimeout(syncTick, 1500);
+  window.setInterval(syncTick, 8000);
+  let lastBoard = '';
+  boardStore.subscribe(() => {
+    const b = boardStore.activeTab?.fileName || '';
+    if (b && b !== lastBoard) { lastBoard = b; void pull(b); }
+  });
+}
+
+export interface MeterApi {
+  ports(): Promise<{ ports: { port: string; desc: string }[]; status: MeterStatus; rigol_host: string }>;
+  connect(o: Record<string, string>): Promise<unknown>;
+  disconnect(): Promise<unknown>;
+  status(): Promise<MeterStatus>;
+  learn(o: Record<string, string>): Promise<{ ok?: boolean; path?: string; error?: string }>;
+  who?(): Promise<{ name: string; email: string }>;
+  histList?(board: string): Promise<{ rows: unknown[]; where?: string; error?: string }>;
+  histSave?(recs: unknown[]): Promise<{ ok: boolean; n?: number; where?: string; error?: string }>;
+}
+export function meterApi(): MeterApi | null {
+  return (window as unknown as { __2rMeterApi?: MeterApi }).__2rMeterApi ?? null;
+}
diff --git a/src/frontend/src/r2/probe-seq.ts b/src/frontend/src/r2/probe-seq.ts
new file mode 100644
index 00000000..ef32df3f
--- /dev/null
+++ b/src/frontend/src/r2/probe-seq.ts
@@ -0,0 +1,202 @@
+/**
+ * 2R Tools: sequência de mapeamento e ponto de medição mais próximo (Roger, 10/10/2026).
+ *
+ * «Quando for mapear o componente, sempre começa pelo pino 1 e a sequência é
+ *  sempre anti-horário… num conector FPC, ímpares de um lado e pares do outro,
+ *  então precisa configurar para seguir os pares ou os ímpares primeiro.»
+ * «Muitas vezes o componente está soldado e não temos acesso ao pad, mas no BDV
+ *  ele já indica o ponto mais próximo para medição.»
+ */
+import { boardStore } from '../store/board-store';
+import { getFormat } from '../parsers/registry';
+import type { BoardData, Part, Pin } from '../parsers/types';
+
+export type SeqRule = 'ccw' | 'cw' | 'odd' | 'even' | 'num';
+export const SEQ_LABEL: Record<SeqRule, string> = {
+  ccw: 'Pino 1, anti-horário (padrão)',
+  cw: 'Pino 1, horário',
+  odd: 'Ímpares primeiro, depois pares (FPC)',
+  even: 'Pares primeiro, depois ímpares (FPC)',
+  num: 'Ordem dos números (1, 2, 3…)',
+};
+
+const RULE_KEY = '2r-seq-rule';
+const AUTO_KEY = '2r-seq-auto';
+const SKIPGND_KEY = '2r-seq-skipgnd';
+const get = (k: string, d: string) => { try { return localStorage.getItem(k) ?? d; } catch { return d; } };
+const put = (k: string, v: string) => { try { localStorage.setItem(k, v); } catch { /* */ } };
+
+export const seqPrefs = {
+  get rule(): SeqRule { return (get(RULE_KEY, 'ccw') as SeqRule); },
+  set rule(v: SeqRule) { put(RULE_KEY, v); },
+  get auto(): boolean { return get(AUTO_KEY, '1') === '1'; },
+  set auto(v: boolean) { put(AUTO_KEY, v ? '1' : '0'); },
+  get skipGnd(): boolean { return get(SKIPGND_KEY, '0') === '1'; },
+  set skipGnd(v: boolean) { put(SKIPGND_KEY, v ? '1' : '0'); },
+};
+
+/** Regra escolhida por componente (ex.: J5 = FPC, ímpares primeiro). */
+const PART_RULE_KEY = '2r-seq-rule-part';
+function partRules(): Record<string, SeqRule> {
+  try { return JSON.parse(localStorage.getItem(PART_RULE_KEY) || '{}'); } catch { return {}; }
+}
+export function ruleFor(board: string, part: string): SeqRule {
+  return partRules()[board + '|' + part] ?? seqPrefs.rule;
+}
+export function setRuleFor(board: string, part: string, rule: SeqRule) {
+  const r = partRules(); r[board + '|' + part] = rule;
+  try { localStorage.setItem(PART_RULE_KEY, JSON.stringify(r)); } catch { /* */ }
+}
+
+/** Número do pino para ordenar: "12" → 12, "A3" (BGA) → linha A coluna 3. */
+function pinKey(p: Pin): [number, number] {
+  const s = (p.number || p.name || '').trim().toUpperCase();
+  const n = /^\d+$/.exec(s);
+  if (n) return [0, parseInt(s, 10)];
+  const m = /^([A-Z]+)(\d+)$/.exec(s);
+  if (m) {
+    let row = 0; for (const c of m[1]) row = row * 26 + (c.charCodeAt(0) - 64);
+    return [row, parseInt(m[2], 10)];
+  }
+  const d = /(\d+)/.exec(s);
+  return [1e6, d ? parseInt(d[1], 10) : 0];
+}
+const byNumber = (a: Pin, b: Pin) => { const x = pinKey(a), y = pinKey(b); return x[0] - y[0] || x[1] - y[1]; };
+
+/** Sentido em que a numeração de um CI corre ao redor do centro: +1, −1 ou 0 (não dá para dizer). */
+function numberingWinding(part: Part): number {
+  const nums = part.pins.map((p, i) => ({ k: pinKey(p), i })).filter(o => o.k[0] === 0);
+  if (nums.length < 6 || nums.length > 400) return 0;
+  nums.sort((a, b) => a.k[1] - b.k[1]);
+  let cx = 0, cy = 0;
+  for (const p of part.pins) { cx += p.position.x; cy += p.position.y; }
+  cx /= part.pins.length; cy /= part.pins.length;
+  const ang = nums.map(o => Math.atan2(part.pins[o.i].position.y - cy, part.pins[o.i].position.x - cx));
+  let sum = 0, pos = 0, neg = 0;
+  for (let k = 1; k < ang.length; k++) {
+    let d = ang[k] - ang[k - 1];
+    while (d > Math.PI) d -= 2 * Math.PI;
+    while (d <= -Math.PI) d += 2 * Math.PI;
+    sum += d;
+    if (d > 1e-6) pos++; else if (d < -1e-6) neg++;
+  }
+  const steps = pos + neg;
+  if (!steps || Math.abs(sum) < Math.PI * 1.4 || Math.max(pos, neg) / steps < 0.8) return 0;
+  return sum > 0 ? 1 : -1;
+}
+
+const calib = new WeakMap<BoardData, { top: number; bottom: number }>();
+
+/**
+ * Sinal do ângulo que é «anti-horário» para quem olha o componente. Cada formato
+ * guarda o eixo Y de um jeito e o lado de baixo vem espelhado, então a própria
+ * placa calibra: nos CIs a numeração corre no sentido anti-horário (padrão da
+ * indústria) e a maioria dos CIs de cada lado decide. Sem CIs, vale o eixo Y do formato.
+ */
+function screenSense(board: BoardData, part: Part): number {
+  let c = calib.get(board);
+  if (!c) {
+    const votes = { top: 0, bottom: 0 };
+    for (const p of board.parts) if (p.side === 'top' || p.side === 'bottom') votes[p.side] += numberingWinding(p);
+    const flip = board.flipY !== undefined ? board.flipY : (getFormat(board.format)?.flipY ?? false);
+    const guessTop = flip ? 1 : -1;
+    const top = votes.top ? Math.sign(votes.top) : votes.bottom ? -Math.sign(votes.bottom) : guessTop;
+    const bottom = votes.bottom ? Math.sign(votes.bottom) : -top;
+    c = { top, bottom };
+    calib.set(board, c);
+  }
+  return part.side === 'bottom' ? c.bottom : c.top;
+}
+
+/** Índices dos pinos do componente na ordem de mapeamento. */
+export function pinOrder(board: BoardData, part: Part, rule: SeqRule, skipGnd = false): number[] {
+  let idx = part.pins.map((_, i) => i);
+  if (skipGnd) idx = idx.filter(i => !/^GND$|^VSS$|^PGND$|^AGND$/i.test(part.pins[i].net || ''));
+  const pins = part.pins;
+  const numeric = [...idx].sort((a, b) => byNumber(pins[a], pins[b]));
+  if (rule === 'num') return numeric;
+  if (rule === 'odd' || rule === 'even') {
+    const isOdd = (i: number) => pinKey(pins[i])[1] % 2 === 1;
+    const odd = numeric.filter(isOdd), even = numeric.filter(i => !isOdd(i));
+    return rule === 'odd' ? [...odd, ...even] : [...even, ...odd];
+  }
+  if (idx.length < 3) return numeric;
+  // Anti-horário / horário em volta do centro, começando pelo pino 1.
+  let cx = 0, cy = 0;
+  for (const i of idx) { cx += pins[i].position.x; cy += pins[i].position.y; }
+  cx /= idx.length; cy /= idx.length;
+  const sense = screenSense(board, part) * (rule === 'cw' ? -1 : 1);
+  const first = numeric[0];
+  const ang = (i: number) => Math.atan2((pins[i].position.y - cy) * sense, pins[i].position.x - cx);
+  const a0 = ang(first);
+  const rel = (i: number) => { let d = ang(i) - a0; while (d < -1e-6) d += 2 * Math.PI; return d; };
+  const dist = (i: number) => Math.hypot(pins[i].position.x - cx, pins[i].position.y - cy);
+  let maxR = 0; for (const i of idx) maxR = Math.max(maxR, dist(i));
+  // Pad central (térmico) e pinos internos vão para o fim, na ordem dos números.
+  const outer = idx.filter(i => dist(i) >= maxR * 0.35);
+  const inner = numeric.filter(i => dist(i) < maxR * 0.35);
+  outer.sort((a, b) => (a === first ? -1 : b === first ? 1 : rel(a) - rel(b) || dist(b) - dist(a)));
+  return [...outer, ...inner];
+}
+
+/** O pino seguinte (ou anterior) na sequência do componente selecionado. */
+export function stepPin(dir: 1 | -1): boolean {
+  const tab = boardStore.activeTab;
+  const sel = tab?.selection;
+  if (!tab?.board || sel?.partIndex == null) return false;
+  const part = tab.board.parts[sel.partIndex];
+  if (!part) return false;
+  const order = pinOrder(tab.board, part, ruleFor(tab.fileName, part.name), seqPrefs.skipGnd);
+  if (!order.length) return false;
+  const at = sel.pinIndex == null ? -1 : order.indexOf(sel.pinIndex);
+  const next = at < 0 ? (dir > 0 ? 0 : order.length - 1) : at + dir;
+  if (next < 0 || next >= order.length) {
+    boardStore.addToast(dir > 0 ? `${part.name}: último pino da sequência.` : `${part.name}: primeiro pino.`, 'info');
+    return false;
+  }
+  boardStore.selectPin(sel.partIndex, order[next]);
+  return true;
+}
+
+export interface ProbePoint {
+  partIndex: number; pinIndex: number; part: string; pin: string;
+  mm: number; side: Part['side']; kind: 'teste' | 'passivo' | 'outro';
+}
+
+const IC_RE = /^(U|Q|J|CN|BGA|IC)\d/i;
+
+/**
+ * Pontos onde dá para medir a mesma net do pino selecionado, do mais perto ao
+ * mais longe: ponto de teste (1 pino) e passivos (capacitor, resistor, bobina),
+ * que ficam com o terminal exposto. Componentes com muitos pinos ficam de fora.
+ */
+export function probePoints(max = 4): { from: string; net: string; points: ProbePoint[] } | null {
+  const tab = boardStore.activeTab;
+  const sel = tab?.selection;
+  const board = tab?.board;
+  if (!board || sel?.partIndex == null || sel.pinIndex == null || sel.pinIndex < 0) return null;
+  const part = board.parts[sel.partIndex];
+  const pin = part?.pins[sel.pinIndex];
+  if (!part || !pin) return null;
+  const from = `${part.name}.${pin.number || pin.name}`;
+  if (!pin.net || /^(NC|N\/C|NO_?CONNECT)$/i.test(pin.net)) return { from, net: pin.net || '', points: [] };
+  const net = board.nets.get(pin.net);
+  if (!net) return { from, net: pin.net, points: [] };
+  const best = new Map<number, ProbePoint>();
+  for (const { partIndex, pinIndex } of net.pinIndices) {
+    if (partIndex === sel.partIndex) continue;
+    const p = board.parts[partIndex];
+    if (!p || p.hidden) continue;
+    const n = p.pins.length;
+    const kind: ProbePoint['kind'] = n === 1 ? 'teste' : n <= 3 && !IC_RE.test(p.name) ? 'passivo' : 'outro';
+    if (kind === 'outro') continue;
+    const q = p.pins[pinIndex];
+    const mm = Math.hypot(q.position.x - pin.position.x, q.position.y - pin.position.y) * 0.0254;
+    const cur = best.get(partIndex);
+    if (!cur || mm < cur.mm) best.set(partIndex, { partIndex, pinIndex, part: p.name, pin: q.number || q.name, mm, side: p.side, kind });
+  }
+  const same = (s: Part['side']) => s === part.side || s === 'both' || part.side === 'both';
+  const points = [...best.values()].sort((a, b) =>
+    (same(a.side) ? 0 : 1) - (same(b.side) ? 0 : 1) || a.mm - b.mm).slice(0, max);
+  return { from, net: pin.net, points };
+}
