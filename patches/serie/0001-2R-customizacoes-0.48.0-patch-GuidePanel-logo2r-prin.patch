+        <div className={`r2acv-note ${st.state === 'error' ? 'r2acv-msg err' : ''}`}>{st.text}</div>
+        {msg && <div className="r2acv-note">{msg}</div>}
+        {st.state === 'on' && (
+          <div className="r2meter-live">
+            <span className="r2meter-val">{live?.value == null ? 'OL' : live.value.toFixed(4)}</span>
+            <span className="r2meter-unit">{live?.unit || ''}</span>
+          </div>
+        )}
+        <div className="r2acv-note">{meterStore.capture.auto
+          ? 'Clique no pino na placa e encoste a ponta: quando a leitura firma, ela entra sozinha na lista abaixo.'
+          : `Clique no pino na placa, encoste a ponta e aperte ${keyName(meterStore.capture.key)} para gravar.`}</div>
+      </div>
+      <CaptureSection />
+      <MapSection />
+      <div className="r2acv-section">
+        <div className="r2meter-tolrow">
+          <span>Tolerância:</span>
+          {(['diodo', 'tensao', 'resistencia'] as Mode[]).map(m => (
+            <label key={m} className="r2meter-tol">{MODE_LABEL[m]}
+              <input type="number" min={0} max={100} value={tol[m]} onChange={e => meterStore.setTolerance(m, Number(e.target.value) || 0)} />%
+            </label>
+          ))}
+        </div>
+      </div>
+      <div className="r2acv-section">
+        <div className="r2meter-histhead">
+          <b>Histórico ({meterStore.shown.length})</b>
+          <button className="r2meter-icon" title="Salvar em planilha (CSV)" onClick={csv} disabled={!meterStore.shown.length}><IconDownload size={14} /></button>
+          {sure
+            ? <button className="r2meter-icon r2hist-sure" onClick={() => { meterStore.clear(); setSure(false); }} onBlur={() => setSure(false)} autoFocus>Apagar as desta placa?</button>
+            : <button className="r2meter-icon" title="Limpar o histórico" onClick={() => setSure(true)} disabled={!meterStore.shown.length}><IconTrash size={14} /></button>}
+        </div>
+        <div className="r2acv-note r2hist-where">{meterStore.where === 'placa'
+          ? 'Salvo junto do boardview (pasta da placa): abre junto com ela em qualquer computador.'
+          : meterStore.where === 'loja'
+          ? 'Salvo na pasta da loja: todos os computadores veem estas medições.'
+          : meterStore.where === 'local' ? 'Salvo só neste computador (a pasta da loja não está ligada).' : ''}
+          {meterStore.pending > 0 && ` Aguardando enviar: ${meterStore.pending}.`}</div>
+        <table className="r2acv-table r2meter-table">
+          <thead><tr><th>Pino</th><th>Medido</th><th>Esperado</th><th></th><th></th></tr></thead>
+          <tbody>
+            {meterStore.shown.slice(0, 300).map(m => (
+              <tr key={m.t} className={`r2meter-${m.status} ${meterStore.redo?.t === m.t ? 'r2hist-redo' : ''}`}
+                  title={`${MODE_LABEL[m.mode]} · ${m.source} · ${m.board}${m.edited ? ` · corrigido à mão (era ${(m.orig ?? 0).toFixed(3)})` : ''}`}>
+                <td className="r2acv-td-board">
+                  {m.part}.{m.pin}{m.via && <span className="r2map-via"> · em {m.via}</span>}
+                  <span className="r2hist-sub">{m.net}</span>
+                  <span className="r2hist-sub">{fmtWhen(m.t)}{m.by ? ' · ' + m.by : ''}</span>
+                </td>
+                <td>{editing === m.t ? <EditValue t={m.t} value={m.value} onDone={() => setEditing(null)} />
+                  : <>{m.value.toFixed(3)}{m.edited && <span className="r2hist-ed" title="Corrigido à mão">*</span>}</>}</td>
+                <td>{m.expected || '—'}</td>
+                <td>{m.status === 'ok' ? '✓' : m.status === 'fora' ? '✕' : ''}</td>
+                <td className="r2hist-act">
+                  <button title={meterStore.redo?.t === m.t ? 'Cancelar: não medir de novo' : 'Medir de novo (a próxima leitura desse pino substitui esta)'}
+                          onClick={() => (meterStore.redo?.t === m.t ? meterStore.cancelRedo() : meterStore.remeasure(m.t))}>↻</button>
+                  <button title="Corrigir o valor" onClick={() => setEditing(m.t)}>✎</button>
+                  <button title="Apagar esta medição" onClick={() => meterStore.remove(m.t)}>×</button>
+                </td>
+              </tr>
+            ))}
+          </tbody>
+        </table>
+      </div>
+    </div>
+  );
+}
