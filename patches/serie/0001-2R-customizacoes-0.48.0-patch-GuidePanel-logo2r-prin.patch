+    api.connect(kind === 'rigol' ? { kind, host, port: '5555' } : { kind, port, baud });
+  };
+  const learn = async () => {
+    setMsg('Gravando 10 s do que o C09 manda… mexa nas pontas.');
+    const r = await api.learn({ port, baud });
+    setMsg(r.ok ? 'Pronto: arquivo C09_captura.txt na Mesa. Mande para o suporte.' : 'Não consegui gravar: ' + (r.error || ''));
+  };
+  const csv = () => {
+    const head = 'data;quem mediu;placa;componente;pino;net;modo;medido;unidade;esperado;resultado;aparelho;medido_em;editado\n';
+    const rows = meterStore.shown.map(m => [new Date(m.t).toLocaleString('pt-BR'), m.by || '', m.board, m.part, m.pin, m.net, MODE_LABEL[m.mode],
+      m.value.toFixed(4).replace('.', ','), m.unit, m.expected, m.status, m.source, m.via || '',
+      m.edited ? 'sim (era ' + (m.orig ?? 0).toFixed(4).replace('.', ',') + ')' : ''].join(';')).join('\n');
+    const a = document.createElement('a');
+    a.href = URL.createObjectURL(new Blob([head + rows], { type: 'text/csv' }));
+    a.download = 'medicoes.csv'; a.click();
+  };
+  return (
+    <div className="r2acv r2meter">
+      <div className="r2acv-title"><IconGauge size={16} /> Medições <span className="r2acv-sub">{st.state === 'on' ? 'ligado' : 'desligado'}</span></div>
+      <div className="r2acv-section r2meter-conn">
+        <div className="r2meter-kinds">
+          <button className={`r2meter-kind ${kind === 'rigol' ? 'sel' : ''}`} onClick={() => setKind('rigol')} disabled={on}>Rigol DM858E (rede)</button>
+          <button className={`r2meter-kind ${kind === 'i2c' ? 'sel' : ''}`} onClick={() => setKind('i2c')} disabled={on}>i2C C09 (USB)</button>
+        </div>
+        {kind === 'rigol' ? (
+          <label className="r2meter-field">IP do Rigol (Utility › I/O › LAN)
+            <input value={host} onChange={e => setHost(e.target.value)} placeholder="ex.: 192.168.0.50" disabled={on} />
+          </label>
+        ) : (
+          <div className="r2acv-two">
+            <label className="r2meter-field">Porta USB
+              <select value={port} onChange={e => setPort(e.target.value)} disabled={on}>
+                {ports.length === 0 && <option value="">(nenhuma porta)</option>}
+                {ports.map(p => <option key={p.port} value={p.port}>{p.port.replace('/dev/', '')}{p.desc ? ' — ' + p.desc : ''}</option>)}
+              </select>
+            </label>
+            <label className="r2meter-field">Velocidade
+              <select value={baud} onChange={e => setBaud(e.target.value)} disabled={on}>
+                {['2400', '9600', '19200', '38400', '115200'].map(b => <option key={b} value={b}>{b}</option>)}
+              </select>
+            </label>
+          </div>
+        )}
+        <div className="r2meter-actions">
+          {!on
+            ? <button className="r2acv-send r2meter-btn" onClick={connect} disabled={kind === 'rigol' ? !host.trim() : !port}><IconPlugConnected size={14} /> Ligar</button>
+            : <button className="r2meter-btn r2meter-off" onClick={() => api.disconnect()}><IconPlugConnectedX size={14} /> Desligar</button>}
+          {kind === 'i2c' && !on && <button className="r2meter-btn r2meter-off" onClick={learn} disabled={!port}>Aprender (10 s)</button>}
+          {kind === 'i2c' && !on && <button className="r2meter-btn r2meter-off" onClick={() => api.ports().then(r => setPorts(r.ports))}>Procurar portas</button>}
