+export const SPLIT_LABELS: Record<SplitLayout, string> = {
+  'board': 'Só a placa',
+  'board-pdf': 'Placa | PDF',
+  'board-mic': 'Placa | Microscópio',
+  'pdf-mic': 'PDF | Microscópio',
+  'board-pdf-mic': 'Placa | PDF | Microscópio',
+};
+
+/** Arruma os painéis lado a lado conforme a escolha do técnico. Abre o PDF
+ *  ligado à placa e o microscópio quando a escolha pede e eles não estão abertos. */
+export function applySplitLayout(layout: SplitLayout, _retry = 0): void {
+  try {
+    const api = getDockviewApi();
+    if (!api) return;
+    if (api.hasMaximizedGroup()) api.exitMaximizedGroup();
+    const tab = boardStore.activeTab;
+    const board = (tab ? api.getPanel(boardPanelId(tab.id)) : undefined)
+      ?? api.panels.find(p => p.id.startsWith('board-'));
+    const pdfName = tab?.pdfFileNames?.[0];
+    const wantsPdf = layout.includes('pdf');
+    const wantsMic = layout.includes('mic');
+    let pdf = pdfName ? api.getPanel(pdfPanelId(pdfName)) : api.panels.find(p => p.id.startsWith('pdf-'));
+    if (wantsPdf && !pdf) {
+      if (!pdfName) { boardStore.addToast('Nenhum PDF aberto com esta placa.', 'info'); return; }
+      ensurePdfPanel(pdfName);
+      if (_retry < 5) setTimeout(() => applySplitLayout(layout, _retry + 1), 250);
+      return;
+    }
+    let mic = api.getPanel(microscopePanelId());
+    if (wantsMic && !mic) {
+      ensureMicroscopePanel();
+      mic = api.getPanel(microscopePanelId());
+    }
+    if (!wantsMic && mic) { mic.api.close(); mic = undefined; }
+    if (layout !== 'pdf-mic' && !board) { boardStore.addToast('Abra uma placa primeiro.', 'info'); return; }
+
+    if (layout === 'board') {
+      if (pdf && board) pdf.api.moveTo({ group: board.group, position: 'center' });
+      board!.api.setActive();
+      api.maximizeGroup(board!);
+      return;
+    }
+    if (layout === 'board-pdf' && board && pdf) {
+      pdf.api.moveTo({ group: board.group, position: 'right' });
+    } else if (layout === 'board-mic' && board && mic) {
+      if (pdf) pdf.api.moveTo({ group: board.group, position: 'center' });
+      board.api.setActive();
+      mic.api.moveTo({ group: board.group, position: 'right' });
+    } else if (layout === 'pdf-mic' && pdf && mic) {
+      if (board) board.api.moveTo({ group: pdf.group, position: 'center' });
+      pdf.api.setActive();
+      mic.api.moveTo({ group: pdf.group, position: 'right' });
+    } else if (layout === 'board-pdf-mic' && board && pdf && mic) {
+      pdf.api.moveTo({ group: board.group, position: 'right' });
+      mic.api.moveTo({ group: pdf.group, position: 'right' });
+    }
+    board?.api.setActive();
+    if (layout === 'pdf-mic') pdf?.api.setActive();
+  } catch (err) {
+    log.ui.error('Failed to apply split layout:', err);
+  }
+}
