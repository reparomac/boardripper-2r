+.r2rep-foot { display:flex; align-items:center; gap:10px; padding:11px 2px 4px; }
+.r2rep-saved { font-size:11.5px; color:var(--r2-dim,#9AA0A6); }
+.r2rep-print-head { display:none; }
+/* Impressão: folha branca, padrão 2R (logo + título, tabela preta e cinza, rodapé) */
+@media print {
+  body * { visibility:hidden !important; }
+  .r2rep, .r2rep * { visibility:visible !important; }
+  .r2rep { position:absolute; left:0; top:0; width:100%; margin:0; padding:24px 28px; background:#fff !important; color:#1a1a1a !important; }
+  .r2rep-print-head { display:block; border-bottom:2px solid #1F2933; padding-bottom:8px; margin-bottom:14px; }
+  .r2rep-print-head .b { font-size:20px; font-weight:900; letter-spacing:1px; color:#1F2933; }
+  .r2rep-print-head .b small { font-size:10px; letter-spacing:3px; color:#52606D; font-weight:700; }
+  .r2rep-ti,.r2rep-nm,.r2rep-v { color:#1a1a1a !important; }
+  .r2rep-sub,.r2rep-pt,.r2rep-tp,.r2rep-n { color:#52606D !important; }
+  .r2rep-chip { border-color:#B5B5B5 !important; color:#1F2933 !important; }
+  .r2rep-chip.bad { border-color:#C0392B !important; color:#C0392B !important; }
+  .r2rep-tbl { border-color:#B5B5B5 !important; }
+  .r2rep-thd { background:#E4E4E4 !important; color:#1F2933 !important; }
+  .r2rep-row { border-top-color:#DADFE6 !important; }
+  .r2rep-row.fora { background:#FBEAE6 !important; }
+  .r2rep-v.bad,.r2rep-res.fora { color:#C0392B !important; }
+  .r2rep-res.ok { color:#52606D !important; }
+  .r2rep-foot { display:none !important; }
+  .r2rep-saved,.r2acv-note { display:none !important; }
+}
