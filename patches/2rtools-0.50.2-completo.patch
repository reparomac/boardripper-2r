+  padding: 2px 6px;
+}
+.r2-legend-head {
+  gap: 6px;
+}
+.r2-legend-group {
+  margin-top: 3px;
+  display: flex;
+  flex-wrap: wrap;
+  gap: 1px 8px;
+  align-items: flex-start;
+}
+.r2-legend-label {
+  flex: 0 0 100%;
+  margin-bottom: 0;
+  font-size: 0.82em;
+  letter-spacing: 0.3px;
+}
+.r2-legend-row {
+  flex: 0 1 auto;
+  max-width: 100%;
+  align-items: flex-start;
+  gap: 4px;
+  padding: 0;
+}
+.r2-legend-dot {
+  width: 8px;
+  height: 8px;
+  flex: 0 0 8px;
+  margin-top: 0.28em;
+}
+.r2-legend-kw {
+  white-space: normal;
+  overflow: visible;
+  text-overflow: clip;
+  overflow-wrap: anywhere;
+  min-width: 0;
+}
+.r2-legend.embedded {
+  max-width: none;
+  width: auto;
+  padding: 3px 8px;
+  opacity: 1;
+}
+.r2-legend-sidebar {
+  max-height: none;
+  overflow: auto;
+  position: relative;
+  border-top: 3px double var(--r2-line-soft);
+}
+.r2-legend-sidebar::before {
+  content: "";
+  position: absolute;
+  left: 0;
+  right: 0;
+  top: -3px;
+  height: 9px;
+  cursor: ns-resize;
