+// 1) o que o app injeta (__2rLang); 2) ?lang= no endereço (o app também manda);
+// 3) o último idioma visto (localStorage); 4) português.
+function pickLang(): string {
+  const w = window as unknown as { __2rLang?: string };
+  let l = w.__2rLang || '';
+  try { if (!l) l = new URLSearchParams(location.search).get('lang') || ''; } catch { /* sem URL */ }
+  try { if (!l) l = localStorage.getItem('2r-lang') || ''; } catch { /* sem storage */ }
+  l = (l || 'pt').slice(0, 2).toLowerCase();
+  try { localStorage.setItem('2r-lang', l); } catch { /* sem storage */ }
+  return l;
+}
+function lang(): 'pt' | 'es' | 'en' {
+  const l = pickLang();
+  return l === 'es' ? 'es' : l === 'en' ? 'en' : 'pt';
+}
+// 2R 22/10/2026: traduções extras injetadas pelo app (data/ui/boardripper_tr.json → window.__2rTrEn / __2rTrEs)
+const R2W = window as unknown as { __2rTrEs?: Record<string, string>; __2rTrEn?: Record<string, string> };
+const DICT: Record<string, string> = lang() === 'es' ? { ...ES, ...MINE_ES, ...(R2W.__2rTrEs || {}) } : lang() === 'en' ? { ...MINE_EN, ...(R2W.__2rTrEn || {}) } : PT;
+
+const ATTRS = ['placeholder', 'title', 'aria-label', 'data-tooltip'];
+
+function tr(s: string | null): string | null {
+  if (!s) return null;
+  const k = s.trim();
+  const v = DICT[k];
+  return v && v !== k ? s.replace(k, v) : null;
+}
+
+function walk(root: Node) {
+  if (root.nodeType === Node.TEXT_NODE) {
+    const v = tr(root.nodeValue);
+    if (v !== null) root.nodeValue = v;
+    return;
+  }
+  if (!(root instanceof Element)) return;
+  if (root.closest('.pdf-viewer canvas, .textLayer')) return;     // conteúdo do PDF não se mexe
+  for (const a of ATTRS) {
+    const v = tr(root.getAttribute(a));
+    if (v !== null) root.setAttribute(a, v);
+  }
+  const it = document.createTreeWalker(root, NodeFilter.SHOW_TEXT | NodeFilter.SHOW_ELEMENT);
+  let n: Node | null = it.nextNode();
+  while (n) {
+    if (n.nodeType === Node.TEXT_NODE) {
+      const v = tr(n.nodeValue);
+      if (v !== null) n.nodeValue = v;
+    } else if (n instanceof Element) {
+      if (n.classList.contains('textLayer')) { n = it.nextSibling() ?? it.nextNode(); continue; }
+      for (const a of ATTRS) {
+        const v = tr(n.getAttribute(a));
+        if (v !== null) n.setAttribute(a, v);
+      }
+    }
+    n = it.nextNode();
+  }
+}
