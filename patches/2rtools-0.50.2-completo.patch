@@ -0,0 +1,73 @@
+import { useEffect, useState } from 'react';
+import { IconX } from '@tabler/icons-react';
+
+/** 2R Tools: Preferências › Mouse e trackpad — aparelho (automático/mouse/trackpad), velocidades (ao vivo). */
+export function openTrackpadPrefs() { window.dispatchEvent(new Event('2r-trackpad-open')); }
+
+const get = (k: string, d: string) => { try { return localStorage.getItem(k) ?? d; } catch { return d; } };
+const put = (k: string, v: string) => { try { localStorage.setItem(k, v); } catch { /* */ } };
+
+export function TrackpadPrefs2R() {
+  const [open, setOpen] = useState(false);
+  const [pan, setPan] = useState(() => parseFloat(get('2r-trackpad-pan', '1.4')));
+  const [zoom, setZoom] = useState(() => parseFloat(get('2r-trackpad-zoom', '1.4')));
+  const [direct, setDirect] = useState(() => get('2r-trackpad-direto', '1') !== '0');
+  // 2R 20/10/2026: FlexBV é o padrão; 27/10/2026: roda do mouse 1,6× (chave nova «2r-mouse-zoom2»), até 5×
+  const [mode, setMode] = useState(() => get('2r-pointer-mode', 'flexbv'));
+  const [mz, setMz] = useState(() => parseFloat(get('2r-mouse-zoom2', '1.6')));
+  const [invM, setInvM] = useState(() => get('2r-mouse-invert', '0') === '1');
+  const [invP, setInvP] = useState(() => get('2r-pan-invert', '0') === '1');
+  const setInv = (m: boolean, p: boolean) => { setInvM(m); setInvP(p); put('2r-mouse-invert', m ? '1' : '0'); put('2r-pan-invert', p ? '1' : '0'); };
+  useEffect(() => {
+    const fn = () => setOpen(true);
+    const key = (e: KeyboardEvent) => { if (e.key === 'Escape') setOpen(false); };
+    window.addEventListener('2r-trackpad-open', fn); window.addEventListener('keydown', key);
+    return () => { window.removeEventListener('2r-trackpad-open', fn); window.removeEventListener('keydown', key); };
+  }, []);
+  if (!open) return null;
+  const row = (label: string, v: number, set: (n: number) => void, k: string) => (
+    <label className="r2-tp-row">
+      <span>{label} <b>{v.toFixed(1).replace('.', ',')}×</b></span>
