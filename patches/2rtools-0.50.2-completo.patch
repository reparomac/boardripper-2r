+    const close = () => setCtx(null);
+    document.addEventListener('mousedown', close);
+    return () => document.removeEventListener('mousedown', close);
+  }, [ctx]);
+
+  const drag: DragApi = {
+    start: (e, idx) => { setFrom(idx); e.dataTransfer.effectAllowed = 'move'; e.dataTransfer.setData('text/plain', String(idx)); },
+    over: (e, idx) => {
+      if (fromRef.current === null) return;
+      e.preventDefault();
+      // «magnético»: gruda à esquerda ou à direita do vizinho, pela metade em que o mouse está
+      const r = (e.currentTarget as HTMLElement).getBoundingClientRect();
+      const side = e.clientX < r.left + r.width / 2 ? 'l' : 'r';
+      const m = markRef.current;
+      if (!m || m.idx !== idx || m.side !== side) setMark({ idx, side });
+    },
+    drop: (e) => {
+      e.preventDefault();
+      const f = fromRef.current, m = markRef.current;
+      if (f === null || !m) return drag.end();
+      const l = [...layout];
+      const [moved] = l.splice(f, 1);
+      let to = m.idx + (m.side === 'r' ? 1 : 0);
+      if (f < to) to -= 1;
+      l.splice(to, 0, moved);
+      commit(l); drag.end();
+    },
+    end: () => { setFrom(null); setMark(null); },
+    markAt: (idx) => [from === idx ? 'dragging' : '', mark?.idx === idx ? `snap-${mark.side}` : ''].join(' '),
+    menu: (e, idx) => { e.preventDefault(); setCtx({ x: e.clientX, y: e.clientY, idx }); },
+  };
+
+  const missing = CATALOG.filter(c => !layout.includes(c.id));
+  const add = (id: string) => { commit([...layout, id]); };
+
+  return (
+    <div className={`nav2r-bar${inline ? ' nav2r-inline' : ''}`} data-testid="nav2r-bar" ref={barRef}
+         onDragOver={e => { if (fromRef.current !== null) e.preventDefault(); }}
+         onDrop={e => { const f = fromRef.current; if (f !== null && !markRef.current) { e.preventDefault(); const l = [...layout]; const [m] = l.splice(f, 1); l.push(m); commit(l); drag.end(); } }}>
+      {layout.map((id, i) => id === SEP
+        ? <div key={'sep' + i} className={`nav2r-slot nav2r-sepslot ${drag.markAt(i)}`} draggable
+               onDragStart={e => drag.start(e, i)} onDragOver={e => drag.over(e, i)} onDrop={drag.drop} onDragEnd={drag.end}
+               onContextMenu={e => drag.menu(e, i)} title="Separador (arraste ou botão direito para tirar)"><span className="nav2r-sep" /></div>
+        : <Slot key={id} id={id} idx={i} drag={drag} />)}
+      <div className="nav2r-pop-wrap" ref={addRef}>
+        <button className="nav2r-btn nav2r-add" title="Adicionar função à barra" onClick={() => setAddOpen(!addOpen)}>
+          <IconPlus size={15} stroke={2} />
+        </button>
+        {addOpen && (
+          <div className="nav2r-pop nav2r-menu nav2r-addmenu">
+            <div className="nav2r-hint">Adicionar à barra (depois é só arrastar para o lugar):</div>
+            {missing.map(c => (
+              <button key={c.id} className="nav2r-item nav2r-item-ico" onClick={() => { add(c.id); }}>
+                {c.icon}<span>{c.label}</span>
+              </button>
+            ))}
+            <button className="nav2r-item" onClick={() => add(SEP)}>│ Separador</button>
+            <div className="nav2r-menu-sep" />
+            <button className="nav2r-item nav2r-item-ico" onClick={() => { commit([...DEFAULT_LAYOUT]); setAddOpen(false); }}>
+              <IconRestore size={15} /><span>Voltar a barra ao padrão</span>
+            </button>
+          </div>
+        )}
+      </div>
+      {ctx && (
+        <div className="nav2r-pop nav2r-menu nav2r-ctx" style={{ position: 'fixed', left: ctx.x, top: ctx.y }}
+             onMouseDown={e => e.stopPropagation()}>
+          <button className="nav2r-item" onClick={() => { const l = [...layout]; l.splice(ctx.idx, 1); commit(l); setCtx(null); }}>
+            Tirar da barra
+          </button>
+          <button className="nav2r-item" onClick={() => { const l = [...layout]; l.splice(ctx.idx + 1, 0, SEP); commit(l); setCtx(null); }}>
+            Pôr um separador depois
+          </button>
+          <button className="nav2r-item" onClick={() => { commit([...DEFAULT_LAYOUT]); setCtx(null); }}>
+            Voltar a barra ao padrão
+          </button>
+        </div>
+      )}
+    </div>
+  );
+}
