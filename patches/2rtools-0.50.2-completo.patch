+// @ts-nocheck
+/* eslint-disable */
+// 2R Tools — geometria dos componentes (pads físicos, contornos, DrMOS, shunt, capacitores, cards do diodo, cruz,
+// contorno externo da placa). Portado VERBATIM das edições à mão do bundle 0.48.0 (20/10 a 27/10/2026).
+// Mudanças pedidas pelo Roger estão comentadas em cada bloco. Chamado por renderer/board-scene.ts e BoardRenderer.ts.
+import { boardStore as U } from '../store/board-store';
+/*2R 20/10/2026 (Roger): pad pequeno ou net selecionada → card do diodo ao lado do pad, virado para dentro do componente (fora quando o componente é pequeno), para o pad ficar à mostra*/ function R2centro(
+  p,
+  k,
+) {
+  if (p.__r2cx == null) {
+    let x = 0,
+      y = 0,
+      n = 0;
+    for (const q of p.pins) q.position && ((x += q.position.x), (y += q.position.y), n++);
+    ((p.__r2cx = n ? x / n : 0), (p.__r2cy = n ? y / n : 0));
+  }
+  return k ? p.__r2cy : p.__r2cx;
+}
+function R2viz(p, q) {
+  if (q.__r2nn == null) {
+    let d = 1 / 0;
+    for (const o of p.pins)
+      if (o !== q && o.position) {
+        const e = Math.hypot(o.position.x - q.position.x, o.position.y - q.position.y);
+        e > 0 && e < d && (d = e);
+      }
+    q.__r2nn = isFinite(d) ? d : 0;
+  }
+  return q.__r2nn;
+}
+function R2tam(b, m, t, C) {
+  /*2R 21/10/2026 (Roger): medição só da linha que está medindo (selecionada) ou do chip selecionado; o resto some. Cards pequenos DENTRO do pad; card maior ao lado só nos pinos da linha selecionada e só se couber no vão entre os pads (sem cobrir o vizinho)*/ b.__side =
+    !1;
+  if (/^[\s\-–—]*$/.test(String(b.text ?? ""))) return 0;
+  if (!b.pad || b.px == null) return C;
+  /*2R 24/10/2026 22h30: o raio do ajuste pode ser maior que o pad desenhado (BGA denso) — limita pela distância até o pino vizinho, para o card nunca passar do pad nem encostar no vizinho*/ const r =
+      Math.min(b.pad, b.nn ? b.nn * 0.46 : b.pad) * t.scale,
+    k =
+      0.6 * Math.max(5, String(b.text).length) +
+      1.1 /*2R 24/10/2026 (Roger: «fora de padrão os tamanhos dos cards»): todo card com a largura de 5 caracteres (0.000); OL não cresce*/,
+    S = U.selection || {},
+    lin = b.net != null && S.highlightedNet === b.net,
+    peca = S.partIndex != null && S.partIndex === b.partIndex,
+    dentro = Math.max(3, Math.min(C, (r * 2 * 0.92) / k));
+  if (!lin && !peca) {
+    /*lente ligada: mostra os valores dos pinos que estão sob a lente (21/10/2026)*/ const L = window.__r2Lente;
+    if (L) {
+      const lx = m.a * b.px + m.c * b.py + m.tx,
+        ly = m.b * b.px + m.d * b.py + m.ty;
+      if (Math.hypot(lx - L.x, ly - L.y) <= L.r) return dentro;
+    }
+    /*2R 24/10/2026 (Roger, igual ao FlexBV): sem poluir — o card só aparece quando o zoom deixa a letra legível DENTRO do pad; por isso os componentes grandes aparecem primeiro, depois os médios e os pequenos. Mínimo em localStorage «2r-obd-min» (px, padrão 7); window.__r2ObdZoomOff=true volta à regra antiga (só linha/peça/lente)*/ if (
+      window.__r2ObdZoomOff === !0
+    )
+      return 0;
+    let mn = 7;
+    try {
+      mn = parseFloat(localStorage.getItem("2r-obd-min") || "7") || 7;
+    } catch {}
+    return dentro >= mn && (r * 2 * 0.92) / k >= mn ? dentro : 0;
+  }
+  if (!lin) {
+    /*2R 24/10/2026 22h25 (Roger: «ainda está poluído… quando tem muitos pads, só aparecer a leitura OBD quando tiver muito zoom e card pequeno»): no componente selecionado vale a mesma regra — o card só aparece quando cabe legível DENTRO do pad*/ let mn2 = 7;
+    try {
+      mn2 = parseFloat(localStorage.getItem("2r-obd-min") || "7") || 7;
+    } catch {}
+    return (r * 2 * 0.92) / k >= mn2 ? dentro : 0;
+  }
+  if (!b.nn) return ((b.__side = !0), C);
+  const x = m.a * b.px + m.c * b.py,
+    y = m.b * b.px + m.d * b.py,
+    cx = m.a * b.cx + m.c * b.cy,
+    cy = m.b * b.cx + m.d * b.cy,
+    p = b.nn * t.scale,
+    g = p - 2 * r - 8,
+    hor = Math.abs(cx - x) >= Math.abs(cy - y),
+    fora = hor ? Math.min(C, g / k, (p - 4) / 1.6) : Math.min(C, g / 1.6, (p - 4) / k);
+  return fora <= dentro * 1.1 ? dentro : ((b.__side = !0), fora);
+}
+function R2lado(b, m, t, G, N) {
+  if (!b.pad || b.px == null) return null;
+  if (!b.__side) return null;
+  const r = b.pad * t.scale,
+    w = G + N * 1.1,
+    h = N * 1.6;
+  const x = m.a * b.px + m.c * b.py + m.tx,
+    y = m.b * b.px + m.d * b.py + m.ty,
+    cx = m.a * b.cx + m.c * b.cy + m.tx,
+    cy = m.b * b.cx + m.d * b.cy + m.ty,
+    dx = cx - x,
+    dy = cy - y,
+    d = Math.hypot(dx, dy),
+    s = d > r + w + 6 ? 1 : -1;
+  return Math.abs(dx) >= Math.abs(dy)
+    ? [x + s * (dx < 0 ? -1 : 1) * (r + w / 2 + 4), y]
+    : [x, y + s * (dy < 0 ? -1 : 1) * (r + h / 2 + 4)];
+}
+/*2R 24/10/2026 21h30 (Roger: «no BDV colocar um ponto de referência, duas linhas cruzadas… sempre manter centralizado com essas duas linhas… padrão em tudo que usa o BDV»): cruz fina no centro da placa, de borda a borda, só referência (não pega clique). localStorage «2r-mira»="0" esconde*/ function R2mira(
+  el,
+) {
+  try {
+    if (!el || el.querySelector(":scope>.r2-mira")) return;
+    if (getComputedStyle(el).position === "static") el.style.position = "relative";
+    const d = document.createElement("div");
+    d.className = "r2-mira";
+    /*09h19 (Roger: «dentro da placa pode deixar mais claro a linha e fora dela mais escura»): a linha usa «diferença» — sobre a placa escura fica cinza-claro, sobre a mesa cinza-clara fica cinza-escuro*/ d.style.cssText =
+      "position:absolute;inset:0;pointer-events:none;z-index:6;mix-blend-mode:difference";
+    const L = "position:absolute;background:rgb(150,150,150)";
+    d.innerHTML =
+      '<i style="' +
+      L +
+      ';left:0;right:0;top:50%;height:1px;transform:translateY(-.5px)"></i><i style="' +
+      L +
+      ';top:0;bottom:0;left:50%;width:1px;transform:translateX(-.5px)"></i>';
+    const up = () => {
+      let on = !0;
+      try {
+        on = localStorage.getItem("2r-mira") !== "0";
+      } catch {}
+      d.style.display = on ? "" : "none";
+    };
+    up();
+    window.addEventListener("storage", up);
+    window.__r2Mira = (v) => {
+      try {
+        localStorage.setItem("2r-mira", v ? "1" : "0");
+      } catch {}
+      up();
+    };
+    el.appendChild(d);
+  } catch {}
+}
+/*2R 24/10/2026 (Roger: «alguns CI estão com falha no contorno… acontece em todos»): o contorno do componente passa a envolver TODOS os pads (o retângulo do arquivo às vezes fica deslocado ou menor que os pads); CI (mais de 4 pinos) com contorno branco, no padrão dos cards. window.__r2CaixaOff=true / __r2CiBranco=false desligam*/ /*2R 27/10/2026 08h24 (print do Roger: U1200, U7800 e U3900 ainda com folga): bola de BGA sem tamanho no arquivo (raio 0) — o desenho usa ~0,45 do passo entre bolas; a margem passa a medir a partir dessa borda. Calculado uma vez por componente*/ function R2raio(
+  P,
+) {
+  if (P.__r2pr !== void 0) return P.__r2pr;
+  P.__r2pr = 0;
+  try {
+    const pts = P.pins.filter((q) => q && q.position).map((q) => q.position),
+      N = Math.min(pts.length, 150);
+    let pm = 1 / 0;
+    for (let i = 0; i < N; i++)
+      for (let j = 0; j < pts.length; j++) {
+        if (i === j) continue;
+        const d = Math.hypot(pts[i].x - pts[j].x, pts[i].y - pts[j].y);
+        d > 1e-6 && d < pm && (pm = d);
+      }
+    isFinite(pm) && (P.__r2pr = pm * 0.45);
+  } catch {}
