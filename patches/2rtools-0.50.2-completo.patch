+                            {gs && <button title="Próximo passo do grupo (→ ↓)" disabled={gin && (cp.step.gk || 1) >= (r.step.gm || 1)}
+                                           onClick={() => { if (gin) guideStore.next(); else { if (!guideStore.on) guideStore.start(); guideStore.go(i + 1); } }}>próximo ›</button>}
+                            <button title="Editar este passo" onClick={() => setEditing(ix)}>✎ editar</button>
+                            <button title="Usar o pino selecionado na placa como ponto deste passo" onClick={() => { const l = guideStore.pinSelectedAsPoint(ix); setMsg(l ? `Ponto do passo ${SS.n}: ${l}` : 'Clique primeiro no pino na placa.'); }}>◆ fixar pino selecionado</button>
+                            {SS.point && <button title="Voltar a escolher o ponto sozinho" onClick={() => guideStore.clearPoint(ix)}>automático</button>}
+                            <button title="Subir" onClick={() => guideStore.moveStep(ix, -1)}>↑</button>
+                            <button title="Descer" onClick={() => guideStore.moveStep(ix, 1)}>↓</button>
+                            <button title="Novo passo depois deste" onClick={() => { guideStore.insertStep(ix); setEditing(ix + 1); }}>+ passo</button>
+                            <button title="Apagar este passo" onClick={() => guideStore.deleteStep(ix)}>apagar</button>
+                          </span>
+                        )}
+                      </>)}
+                    </div>
+                  )}
+                </div>
+              );
+            })}
+          </div>
+          </>}
+          {msg && <div className="r2acv-note">{msg}</div>}
+        </div>
+      )}
+      </div>
+    </div>
+  );
+}
