+/* ===== 2R Tools — CSS que estava editado à mão no bundle 0.48.0 (portado para o fonte em 28/10/2026) ===== */
+/* Relatório do ponto a ponto (r2rep, 12/10/2026) */
+.r2rep {
+  margin-top: 6px;
+}
+.r2rep-head {
+  display: flex;
+  align-items: flex-start;
+  gap: 10px;
+  padding: 4px 2px 12px;
+}
+.r2rep-ti {
+  font-size: 15px;
+  font-weight: 800;
+  color: var(--r2-text, #eceae4);
+}
+.r2rep-sub {
+  font-size: 12px;
+  color: var(--r2-dim, #9aa0a6);
+  margin-top: 2px;
+}
+.r2rep-sum {
+  margin-left: auto;
+  display: flex;
+  gap: 6px;
+  flex-wrap: wrap;
+}
+.r2rep-chip {
+  font-size: 11.5px;
+  font-weight: 700;
+  border: 1px solid var(--r2-line, #33373e);
+  color: var(--r2-dim, #9aa0a6);
+  border-radius: 12px;
+  padding: 3px 9px;
+  white-space: nowrap;
+}
+.r2rep-chip.bad {
+  border-color: #e0864a;
+  color: #e0864a;
+}
+.r2rep-tbl {
+  border: 1px solid var(--r2-line, #2a2d33);
+  border-radius: 10px;
+  overflow: hidden;
+}
+.r2rep-thd,
+.r2rep-row {
+  display: grid;
+  grid-template-columns: 26px 1.3fr 0.9fr 0.8fr 0.8fr 0.7fr 0.8fr;
+  align-items: center;
+  gap: 6px;
+  padding: 8px 10px;
+}
+.r2rep-thd {
+  background: var(--r2-bg2, #16181b);
+  font-size: 10px;
+  font-weight: 800;
+  color: var(--r2-dim, #9aa0a6);
+  letter-spacing: 0.3px;
+  text-transform: uppercase;
+}
+.r2rep-row {
+  border-top: 1px solid var(--r2-line, #1e2125);
+  font-size: 12.5px;
+}
+.r2rep-row.fora {
+  background: #e0864a12;
+}
+.r2rep-n,
+.r2rep-pt {
+  color: var(--r2-mute, #6e6e6a);
+  font-variant-numeric: tabular-nums;
+}
+.r2rep-nm {
+  font-weight: 600;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.r2rep-v {
+  font-variant-numeric: tabular-nums;
+  font-weight: 700;
+}
+.r2rep-v.bad {
+  color: #e0864a;
+}
+.r2rep-tp {
+  color: var(--r2-dim, #9aa0a6);
+  font-size: 11.5px;
+}
+.r2rep-res {
+  font-size: 11px;
+  font-weight: 800;
+  text-align: center;
+}
+.r2rep-res.ok {
+  color: var(--r2-dim, #9aa0a6);
+}
+.r2rep-res.fora {
+  color: #e0864a;
+}
+.r2rep-foot {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  padding: 11px 2px 4px;
+}
+.r2rep-saved {
+  font-size: 11.5px;
+  color: var(--r2-dim, #9aa0a6);
+}
+.r2rep-print-head {
+  display: none;
+}
+@media print {
+  body * {
+    visibility: hidden !important;
+  }
+  .r2rep,
+  .r2rep * {
+    visibility: visible !important;
+  }
+  .r2rep {
+    position: absolute;
+    left: 0;
+    top: 0;
+    width: 100%;
+    margin: 0;
+    padding: 24px 28px;
+    background: #fff !important;
+    color: #1a1a1a !important;
+  }
+  .r2rep-print-head {
+    display: block;
+    border-bottom: 2px solid #1f2933;
+    padding-bottom: 8px;
+    margin-bottom: 14px;
+  }
+  .r2rep-print-head .b {
+    font-size: 20px;
+    font-weight: 900;
+    letter-spacing: 1px;
+    color: #1f2933;
+  }
+  .r2rep-print-head .b small {
+    font-size: 10px;
+    letter-spacing: 3px;
+    color: #52606d;
+    font-weight: 700;
+  }
+  .r2rep-ti,
+  .r2rep-nm,
+  .r2rep-v {
+    color: #1a1a1a !important;
+  }
+  .r2rep-sub,
+  .r2rep-pt,
+  .r2rep-tp,
+  .r2rep-n {
+    color: #52606d !important;
+  }
+  .r2rep-chip {
+    border-color: #b5b5b5 !important;
+    color: #1f2933 !important;
+  }
+  .r2rep-chip.bad {
+    border-color: #c0392b !important;
+    color: #c0392b !important;
+  }
+  .r2rep-tbl {
+    border-color: #b5b5b5 !important;
+  }
+  .r2rep-thd {
+    background: #e4e4e4 !important;
+    color: #1f2933 !important;
+  }
+  .r2rep-row {
+    border-top-color: #dadfe6 !important;
+  }
+  .r2rep-row.fora {
+    background: #fbeae6 !important;
+  }
+  .r2rep-v.bad,
+  .r2rep-res.fora {
+    color: #c0392b !important;
+  }
+  .r2rep-res.ok {
+    color: #52606d !important;
+  }
+  .r2rep-foot,
+  .r2rep-saved,
+  .r2acv-note {
+    display: none !important;
+  }
+}
